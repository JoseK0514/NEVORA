{
  "name": "fuel-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "notifications:worker": "tsx scripts/fuel-notification-worker.ts",
    "test:notifications:qa": "node --test scripts/verify-fuel-phase-3-config.check.mjs",
    "test:notifications:integration": "vitest run --config vitest.notifications-integration.config.mts",
    "test:foundation:integration": "vitest run --config vitest.foundation-integration.config.mts",
    "test:foundation:qa": "node --test scripts/verify-nevora-foundation-config.check.mjs",
    "test:generation:integration": "vitest run --config vitest.generation-integration.config.mts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@neondatabase/serverless": "1.1.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "3.6.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.0.2"
  }
}
