{
  "name": "fuel-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:development-sources": "node scripts/development-source-inventory.mjs",
    "check:inspection-evidence": "node scripts/inspection-evidence.mjs",
    "test": "vitest run",
    "test:dev:production": "node scripts/verify-dev-production-absence.mjs",
    "setup:company": "node --import tsx scripts/setup-company.mts",
    "test:company:integration": "node scripts/phase-c-clocker-postgres.mjs --company-setup",
    "bootstrap:owner": "node --import tsx scripts/bootstrap-owner.mjs",
    "notifications:worker": "node --conditions=react-server --import ./scripts/node-server-context.mjs --import tsx scripts/fuel-notification-worker.ts",
    "test:notifications:qa": "node --test scripts/verify-fuel-phase-3-config.check.mjs",
    "test:notifications:integration": "vitest run --config vitest.notifications-integration.config.mts",
    "test:foundation:integration": "vitest run --config vitest.foundation-integration.config.mts",
    "test:foundation:qa": "node --test scripts/verify-nevora-foundation-config.check.mjs",
    "test:exchanges:integration": "vitest run --config vitest.exchanges-integration.config.mts",
    "test:generation:integration": "vitest run --config vitest.generation-integration.config.mts",
    "test:phase-a:app": "node --import tsx scripts/phase-a-app-qa.mjs",
    "test:phase-b:ui": "node --import tsx scripts/phase-b-ui-qa.mjs",
    "test:navigation:ui": "node --import tsx scripts/nevora-navigation-ui-qa.mjs",
    "test:clocker:integration": "vitest run --config vitest.clocker-integration.config.mts",
    "test:clocker:owned": "node scripts/phase-c-clocker-postgres.mjs",
    "test:release:postgres": "node scripts/phase-c-release-postgres.mjs",
    "test:staff-tasks:owned": "node scripts/payroll-postgres.mjs vitest.staff-tasks-integration.config.mts",
    "test:phase-d:attendance-ui": "node scripts/phase-d-attendance-postgres.mjs",
    "test:phase-d2:corrections-ui": "node scripts/phase-d2-corrections-postgres.mjs",
    "test:phase-e:startup": "node --test scripts/phase-e-owned-startup.check.mjs",
    "test:phase-e:sql": "node scripts/phase-e-owned.mjs sql --suite all",
    "test:phase-e:ui": "node scripts/phase-e-owned.mjs browser --suite all",
    "test:phase-e:evidence": "node scripts/phase-e-owned.mjs verify-ci",
    "test:release-engineering": "node --test scripts/communication-login-diagnostics.check.mjs scripts/employee-hours-return-diagnostic.check.mjs scripts/release-typecheck.check.mjs scripts/release-build-environment.check.mjs scripts/phase-e-proc-environment.check.mjs scripts/attention-revocation-diagnostic.check.mjs scripts/clocker-pin-readiness-diagnostic.check.mjs scripts/home-source-failure-diagnostic.check.mjs scripts/browser-contrast.check.mjs scripts/browser-login-window.check.mjs scripts/browser-response-deadline.check.mjs scripts/ci-ubuntu-mirrors.check.mjs scripts/d2-foreground-recovery.check.mjs scripts/d2-native-retry-diagnostics.check.mjs scripts/d2-native-retry-focus.check.mjs scripts/d2-runtime-failures.check.mjs scripts/owned-login-diagnostics.check.mjs scripts/release-ci-contract.check.mjs scripts/management-review-evidence.check.mjs scripts/release-postgres-cleanup.check.mjs scripts/release-browser-diagnostics.check.mjs scripts/release-lint-chain.check.mjs scripts/rsc-caught-error-observer.check.mjs scripts/role-redirect-diagnostic.check.mjs scripts/step4-local-evidence.check.mjs scripts/central-billing-local-evidence.check.mjs scripts/onboarding-inventory.check.mjs scripts/phase-d-browser-groups.check.mjs",
    "payroll:worker": "node --conditions=react-server --import ./scripts/node-server-context.mjs --import tsx scripts/payroll-worker.ts",
    "test:payroll:owned": "node scripts/payroll-postgres.mjs",
    "test:passkeys:owned": "node scripts/payroll-postgres.mjs vitest.passkeys-integration.config.mts",
    "test:passkeys:network": "node scripts/payroll-postgres.mjs vitest.passkeys-network.config.mts",
    "test:ui:combined": "node scripts/payroll-postgres.mjs vitest.all-ui-browser.config.mts",
    "test:mobile-access:owned": "node scripts/payroll-postgres.mjs vitest.mobile-access-browser.config.mts",
    "onboarding:worker": "node --conditions=react-server --import ./scripts/node-server-context.mjs --import tsx scripts/onboarding-worker.mts --once",
    "check:onboarding-manifest": "node scripts/onboarding-manifest.mjs",
    "onboarding:operator": "node --conditions=react-server --import ./scripts/node-server-context.mjs --import tsx scripts/onboarding-operator.mts",
    "commerce:api": "node --import tsx services/commerce/server.ts",
    "commerce:worker": "node --import tsx services/commerce/worker-cli.ts",
    "commerce:operator": "node --import tsx services/commerce/operator.ts",
    "test:commerce:owned": "node scripts/commerce-postgres.mjs",
    "operations:worker": "node --conditions=react-server --import ./scripts/node-server-context.mjs --import tsx scripts/workforce-operations.mts",
    "format:check": "node scripts/format-critical.mjs --check",
    "format:write": "node scripts/format-critical.mjs --write"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@js-temporal/polyfill": "0.5.1",
    "@neon/functions": "0.11.0",
    "@neondatabase/serverless": "1.1.0",
    "@phosphor-icons/react": "2.1.10",
    "@simplewebauthn/server": "14.0.3",
    "gsap": "3.15.0",
    "next": "16.4.2",
    "nodemailer": "10.4.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "tsx": "4.23.15",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@nevora/eslint-config-next": "file:tools/eslint-config-next",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "3.6.4",
    "@typescript-eslint/typescript-estree": "8.72.1",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
