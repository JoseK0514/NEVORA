{
  "categories": {
    "correctness": "off"
  },
  "plugins": [],
  "jsPlugins": [
    {
      "name": "react-preserved",
      "specifier": "eslint-plugin-react"
    },
    {
      "name": "hooks-preserved",
      "specifier": "eslint-plugin-react-hooks"
    },
    {
      "name": "imports-preserved",
      "specifier": "eslint-plugin-import"
    },
    {
      "name": "a11y-preserved",
      "specifier": "eslint-plugin-jsx-a11y"
    },
    {
      "name": "next-preserved",
      "specifier": "@nevora/eslint-plugin-next"
    }
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.3.0"
    }
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "native/**",
    "next-env.d.ts",
    "tools/eslint-config-next/dist/parser.js",
    "tools/eslint-config-next/dist/typescript.js",
    "tools/eslint-config-next/dist/core-web-vitals.d.ts",
    "tools/eslint-config-next/dist/index.d.ts",
    "tools/eslint-config-next/dist/parser.d.ts",
    "tools/eslint-config-next/dist/typescript.d.ts",
    "tools/eslint-plugin-next/dist/utils/define-rule.js",
    "tools/eslint-plugin-next/dist/rules/google-font-display.js",
    "tools/eslint-plugin-next/dist/rules/google-font-preconnect.js",
    "tools/eslint-plugin-next/dist/index.js",
    "tools/eslint-plugin-next/dist/rules/inline-script-id.js",
    "tools/eslint-plugin-next/dist/rules/next-script-for-ga.js",
    "tools/eslint-plugin-next/dist/rules/no-assign-module-variable.js",
    "tools/eslint-plugin-next/dist/rules/no-async-client-component.js",
    "tools/eslint-plugin-next/dist/rules/no-before-interactive-script-outside-document.js",
    "tools/eslint-plugin-next/dist/rules/no-css-tags.js",
    "tools/eslint-plugin-next/dist/rules/no-document-import-in-page.js",
    "tools/eslint-plugin-next/dist/rules/no-duplicate-head.js",
    "tools/eslint-plugin-next/dist/rules/no-head-element.js",
    "tools/eslint-plugin-next/dist/rules/no-head-import-in-document.js",
    "tools/eslint-plugin-next/dist/rules/no-html-link-for-pages.js",
    "tools/eslint-plugin-next/dist/rules/no-img-element.js",
    "tools/eslint-plugin-next/dist/rules/no-location-assign-relative-destination.js",
    "tools/eslint-plugin-next/dist/rules/no-page-custom-font.js",
    "tools/eslint-plugin-next/dist/rules/no-script-component-in-head.js",
    "tools/eslint-plugin-next/dist/rules/no-styled-jsx-in-document.js",
    "tools/eslint-plugin-next/dist/rules/no-sync-scripts.js",
    "tools/eslint-plugin-next/dist/rules/no-title-in-document-head.js",
    "tools/eslint-plugin-next/dist/rules/no-typos.js",
    "tools/eslint-plugin-next/dist/rules/no-unwanted-polyfillio.js",
    "tools/eslint-plugin-next/dist/utils/node-attributes.js",
    "tools/eslint-plugin-next/dist/utils/url.js",
    "tools/eslint-plugin-next/dist/utils/define-rule.d.ts",
    "tools/eslint-plugin-next/dist/utils/get-root-dirs.d.ts",
    "tools/eslint-plugin-next/dist/rules/google-font-display.d.ts",
    "tools/eslint-plugin-next/dist/rules/google-font-preconnect.d.ts",
    "tools/eslint-plugin-next/dist/index.d.ts",
    "tools/eslint-plugin-next/dist/rules/inline-script-id.d.ts",
    "tools/eslint-plugin-next/dist/rules/next-script-for-ga.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-assign-module-variable.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-async-client-component.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-before-interactive-script-outside-document.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-css-tags.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-document-import-in-page.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-duplicate-head.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-head-element.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-head-import-in-document.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-html-link-for-pages.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-img-element.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-location-assign-relative-destination.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-page-custom-font.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-script-component-in-head.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-styled-jsx-in-document.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-sync-scripts.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-title-in-document-head.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-typos.d.ts",
    "tools/eslint-plugin-next/dist/rules/no-unwanted-polyfillio.d.ts",
    "tools/eslint-plugin-next/dist/utils/node-attributes.d.ts",
    "tools/eslint-plugin-next/dist/utils/url.d.ts"
  ],
  "rules": {
    "react-preserved/display-name": "error",
    "react-preserved/jsx-key": "error",
    "react-preserved/jsx-no-comment-textnodes": "error",
    "react-preserved/jsx-no-duplicate-props": "error",
    "react-preserved/jsx-no-undef": "error",
    "react-preserved/jsx-uses-react": "error",
    "react-preserved/jsx-uses-vars": "error",
    "react-preserved/no-children-prop": "error",
    "react-preserved/no-danger-with-children": "error",
    "react-preserved/no-deprecated": "error",
    "react-preserved/no-direct-mutation-state": "error",
    "react-preserved/no-find-dom-node": "error",
    "react-preserved/no-is-mounted": "error",
    "react-preserved/no-render-return-value": "error",
    "react-preserved/no-string-refs": "error",
    "react-preserved/no-unescaped-entities": "error",
    "react-preserved/require-render-return": "error",
    "hooks-preserved/rules-of-hooks": "error",
    "hooks-preserved/exhaustive-deps": "warn",
    "hooks-preserved/static-components": "error",
    "hooks-preserved/use-memo": "error",
    "hooks-preserved/preserve-manual-memoization": "error",
    "hooks-preserved/incompatible-library": "warn",
    "hooks-preserved/immutability": "error",
    "hooks-preserved/globals": "error",
    "hooks-preserved/refs": "error",
    "hooks-preserved/set-state-in-effect": "error",
    "hooks-preserved/error-boundaries": "error",
    "hooks-preserved/purity": "error",
    "hooks-preserved/set-state-in-render": "error",
    "hooks-preserved/unsupported-syntax": "warn",
    "hooks-preserved/config": "error",
    "hooks-preserved/gating": "error",
    "next-preserved/google-font-display": "warn",
    "next-preserved/google-font-preconnect": "warn",
    "next-preserved/next-script-for-ga": "warn",
    "next-preserved/no-async-client-component": "warn",
    "next-preserved/no-before-interactive-script-outside-document": "warn",
    "next-preserved/no-css-tags": "warn",
    "next-preserved/no-head-element": "warn",
    "next-preserved/no-html-link-for-pages": "error",
    "next-preserved/no-img-element": "warn",
    "next-preserved/no-location-assign-relative-destination": "warn",
    "next-preserved/no-page-custom-font": "warn",
    "next-preserved/no-styled-jsx-in-document": "warn",
    "next-preserved/no-sync-scripts": "error",
    "next-preserved/no-title-in-document-head": "warn",
    "next-preserved/no-typos": "warn",
    "next-preserved/no-unwanted-polyfillio": "warn",
    "next-preserved/inline-script-id": "error",
    "next-preserved/no-assign-module-variable": "error",
    "next-preserved/no-document-import-in-page": "error",
    "next-preserved/no-duplicate-head": "error",
    "next-preserved/no-head-import-in-document": "error",
    "next-preserved/no-script-component-in-head": "error",
    "imports-preserved/no-anonymous-default-export": "warn",
    "a11y-preserved/alt-text": [
      "warn",
      {
        "elements": [
          "img"
        ],
        "img": [
          "Image"
        ]
      }
    ],
    "a11y-preserved/aria-props": "warn",
    "a11y-preserved/aria-proptypes": "warn",
    "a11y-preserved/aria-unsupported-elements": "warn",
    "a11y-preserved/role-has-required-aria-props": "warn",
    "a11y-preserved/role-supports-aria-props": "warn"
  }
}
