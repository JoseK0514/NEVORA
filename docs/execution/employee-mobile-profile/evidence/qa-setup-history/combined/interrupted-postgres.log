	 OR(g.action='ASSIGN' AND g.mode='COMPANY' AND cardinality(g.location_ids)=0)
	 OR(g.action='ASSIGN' AND g.mode='LOCATIONS' AND cardinality(g.location_ids) BETWEEN 1 AND 100
