 report.status='PASS';report.tables=Object.keys(a).length;report.stableTables=stable.length;report.stableStateSha256=sha(JSON.stringify(Object.fromEntries(stable.map(n=>[n,a[n]]))));report.columnLayoutAndSequencesMatch=true;report.appendOnlyPreservation=appendOnly;report.exercisedMutableAuth=exercised;
