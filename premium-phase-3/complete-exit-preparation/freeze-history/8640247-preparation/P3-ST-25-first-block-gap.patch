+/* P3-ST-25: the first visible route placeholder accounts for its parent grid's 20px gap.
+ * Keep later placeholder blocks' spacing and the frozen premium margins unchanged. */
+@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
+  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton.route-skeleton[data-band="overlap"] > .route-skeleton-band + .route-skeleton-header + *:not(#nv-kit) { margin-top: calc(-1 * var(--nv-overlap) - 20px); }
+  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton.route-skeleton[data-band="flat"] > .route-skeleton-band + .route-skeleton-header + *:not(#nv-kit) { margin-top: calc(var(--nv-s-4) - 20px); }
+  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .page-frame:not([data-focused-review]) .route-skeleton.route-skeleton[data-route="review"][data-band] > .route-skeleton-band + .route-skeleton-header + *:not(#nv-kit) { margin-top: calc(var(--nv-s-4) - 20px); }
+  html body .app-shell.nevora-portal.nevora-portal.employee-shell:not(.nv-shell-none) .route-skeleton.route-skeleton:is([data-route="schedule"], [data-route="review"])[data-band] > .route-skeleton-band + .route-skeleton-header + *:not(#nv-kit) { margin-top: calc(var(--nv-s-4) - 20px); }
