@@ -294,3 +294,12 @@
   100% { opacity: 0; transform: translate(var(--x), var(--y)) scale(1) rotate(160deg); }
 }
 @media (prefers-reduced-motion: reduce) { html body .app-shell.nevora-portal .nevora-celebration { display: none; } }
