{
  "name": "nevora-native-spike",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Isolated fictional-data Capacitor feasibility prototype. Not a production app.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "sync": "npm run build && cap sync",
    "android:debug": "npm run build && cap sync android && node scripts/android-build.mjs",
    "ios:simulator": "node scripts/ios-build.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
