 .arrival { padding: 24px 24px 56px; background: var(--home-masthead); color: white; }
 .arrival h1 { font-size: 1.625rem; font-weight: 600; letter-spacing: -.04em; line-height: 1.25; text-wrap: balance; }
 .arrival p { margin-top: 6px; color: #FFFFFF; font-size: .8125rem; }
+.summarySlot, .reviewSlot { display: grid; grid-template-columns: minmax(0, 1fr); }
+.summarySlot > span, .reviewSlot > * { grid-area: 1 / 1; min-width: 0; }
+.summarySizer, .reviewSizer { visibility: hidden; pointer-events: none; user-select: none; }
+/* ST-RC-HOME-01: reserve the measured narrow, large-text heading rows before the private read arrives.
+ * Keep this local override above the coordinator's existing two-line title minimum, without changing its file. */
+@media (max-width: 359px) {
+  :global(html[data-text-step="200"] body .app-shell.nevora-portal .page-frame) .root.root :global(.nv-masthead__title:not(#nv-kit)) { min-height: 3lh; }
+  :global(html[data-text-step="200"] body .app-shell.nevora-portal .page-frame) .root.root :global(.nv-masthead__eyebrow) { min-height: 3lh; }
+  :global(html[data-text-step="150"] body .app-shell.nevora-portal .page-frame) .root.root :global(.nv-masthead__title:not(#nv-kit)) { min-height: 2lh; }
+}
+@media (min-width: 360px) and (max-width: 430px) {
+  :global(html[data-text-step="200"] body .app-shell.nevora-portal .page-frame) .root.root :global(.nv-masthead__title:not(#nv-kit)) { min-height: 2lh; }
+}
 .content { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: -28px; padding-inline: 20px; }
 .mainColumn, .sideColumn { display: grid; align-content: start; gap: 20px; min-width: 0; }
 .sideColumn { gap: 24px; }
