From 81593916aca967a5fc9a881f6756b23e722e974e Mon Sep 17 00:00:00 2001
From: Jose Karlo Natal <josekarlo-@hotmail.com>
Date: Mon, 19 Oct 2026 22:09:01 +0000
Subject: [PATCH 35/45] IS-WA-12: keep field hints out of accessible names

---
 src/components/reviewed-callout-form.tsx | 2 +-
 src/components/select-field.tsx          | 4 +++-
 src/components/wave-a/parts.tsx          | 2 +-
 3 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/components/reviewed-callout-form.tsx b/src/components/reviewed-callout-form.tsx
index 8c0594cf..52a43ae2 100644
--- a/src/components/reviewed-callout-form.tsx
+++ b/src/components/reviewed-callout-form.tsx
@@ -68,7 +68,7 @@ export function ReviewedCalloutForm({
         />
         <div className="wa-field">
         <label className="wa-field__control">
-          <span className="wa-field__label">More details{reason === "OTHER" ? null : <span className="wa-field__optional">Optional</span>}</span>
+          <span className="wa-field__label">More details{reason === "OTHER" ? null : <span className="wa-field__optional" aria-hidden="true">Optional</span>}</span>
           <textarea
             ref={noteInput}
             aria-describedby={detailsId}
diff --git a/src/components/select-field.tsx b/src/components/select-field.tsx
index 1d883ca5..1e30d7d4 100644
--- a/src/components/select-field.tsx
+++ b/src/components/select-field.tsx
@@ -39,6 +39,7 @@ export function SelectField({
 }) {
   const generatedId = useId().replaceAll(":", "");
   const selectId = id ?? `nevora-select-${generatedId}`;
+  const labelId = `${selectId}-label`;
   const hintId = hint ? `${selectId}-hint` : undefined;
 
   return (
@@ -46,7 +47,7 @@ export function SelectField({
       className={className ? `nevora-field ${className}` : "nevora-field"}
       htmlFor={selectId}
     >
-      <span className="nevora-field-label">{label}</span>
+      <span id={labelId} className="nevora-field-label">{label}</span>
       <span className="nevora-select-shell">
         <select
           id={selectId}
@@ -55,6 +56,7 @@ export function SelectField({
           {...(value === undefined ? { defaultValue } : { value })}
           required={required}
           disabled={disabled}
+          aria-labelledby={labelId}
           aria-describedby={hintId}
           onChange={onChange}
         >
diff --git a/src/components/wave-a/parts.tsx b/src/components/wave-a/parts.tsx
index dc46c838..04b69c76 100644
--- a/src/components/wave-a/parts.tsx
+++ b/src/components/wave-a/parts.tsx
@@ -46,7 +46,7 @@ export function Field({ label, optional = false, help, helpId, children, classNa
   return (
     <div className={className ? `wa-field ${className}` : "wa-field"}>
       <label className="wa-field__control">
-        <span className="wa-field__label">{label}{optional ? <span className="wa-field__optional">Optional</span> : null}</span>
+        <span className="wa-field__label">{label}{optional ? <span className="wa-field__optional" aria-hidden="true">Optional</span> : null}</span>
         {children}
       </label>
       {help ? <span className="wa-field__help" id={helpId}>{help}</span> : null}
-- 
