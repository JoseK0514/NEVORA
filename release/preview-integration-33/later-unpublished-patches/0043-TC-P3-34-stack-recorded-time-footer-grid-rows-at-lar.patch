From 581921be39e9211e45ef8d0d4320a81810d182db Mon Sep 17 00:00:00 2001
From: Jose Karlo Natal <josekarlo-@hotmail.com>
Date: Mon, 19 Oct 2026 22:12:24 +0000
Subject: [PATCH 43/45] TC-P3-34: stack recorded-time footer grid rows at large
 phone text

---
 src/app/employee-mobile-corporate.css | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/app/employee-mobile-corporate.css b/src/app/employee-mobile-corporate.css
index bd436e06..a6356d49 100644
--- a/src/app/employee-mobile-corporate.css
+++ b/src/app/employee-mobile-corporate.css
@@ -228,3 +228,9 @@
 @media screen and (max-width: 760px) and (prefers-reduced-motion: reduce), screen and (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) and (prefers-reduced-motion: reduce) {
   html body .app-shell.nevora-portal[data-mobile-workforce="true"][data-employee-corporate="true"] .page-frame :is(button, a, summary) { transition: none; }
 }
+
+/* TC-P3-34: large phone text gives footer copy and its actions separate grid rows. */
+@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
+  html:is([data-text-step="150"], [data-text-step="200"]) body .app-shell.nevora-portal[data-mobile-workforce="true"][data-employee-corporate="true"] .page-frame .employee-time-footer { grid-template-columns: minmax(0, 1fr); }
+  html:is([data-text-step="150"], [data-text-step="200"]) body .app-shell.nevora-portal[data-mobile-workforce="true"][data-employee-corporate="true"] .page-frame .employee-time-footer > .employee-time-controls { grid-column: 1; grid-row: auto; }
+}
