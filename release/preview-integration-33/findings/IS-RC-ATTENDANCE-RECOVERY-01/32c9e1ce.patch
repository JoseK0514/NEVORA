From 32c9e1cef450ab10574555c76b0c2a9bab2ce78e Mon Sep 17 00:00:00 2001
From: Jose Karlo Natal <josekarlo-@hotmail.com>
Date: Tue, 20 Oct 2026 00:28:36 +0000
Subject: [PATCH] IS-RC-ATTENDANCE-RECOVERY-01: retain failed-read and focused
 Attendance recovery

---
 src/app/app/premium-desktop.css              | 6 +++---
 src/components/manager-attendance-review.tsx | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/app/app/premium-desktop.css b/src/app/app/premium-desktop.css
index 605ac6bb..18b758e8 100644
--- a/src/app/app/premium-desktop.css
+++ b/src/app/app/premium-desktop.css
@@ -186,12 +186,12 @@
 html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .page-frame.page-frame > .premium-exports :is(section[data-export-loading] ~ section.panel) { display: none; }
 
 /* Attendance view: "Some comparisons are limited" is only known once the read arrives. It sits after the list,
- * and the footer, "What we compare" and Corrections wait for the read, so nothing is pushed down as it appears
- * (layout shift 0.035 to 0.052). */
+ * and the footer, "What we compare" and Corrections wait during an unfocused cold read
+ * (layout shift 0.035 to 0.052). Failed reads retain recovery; reauthorization keeps focused controls visible. */
 html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .page-frame.page-frame > .premium-home-view .attendance-review { display: flex; flex-direction: column; }
 html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .page-frame.page-frame > .premium-home-view .attendance-review > .attendance-review-limited { order: 1; }
 html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .page-frame.page-frame > .premium-home-view .attendance-review > :is(.attendance-review-footer, details) { order: 2; }
-html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .page-frame.page-frame > .premium-home-view:has(.attendance-review-summary[aria-busy="true"]) :is(.attendance-review-footer, .attendance-review > details, .manager-corrections, .manager-corrections ~ *) { display: none; }
+html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .page-frame.page-frame > .premium-home-view:has(.attendance-review[data-attendance-state="loading"]):not(:focus-within) :is(.attendance-review-footer, .attendance-review > details, .manager-corrections, .manager-corrections ~ *) { display: none; }
 
 /* Inbox filters while the read loads (all widths): the row is disabled and out of the Tab order (IS-59), so it
  * doesn't scroll either; a scrolling region nobody can focus fails axe's scrollable-region-focusable at 320–360. */
diff --git a/src/components/manager-attendance-review.tsx b/src/components/manager-attendance-review.tsx
index c9f71872..6cb0bbbf 100644
--- a/src/components/manager-attendance-review.tsx
+++ b/src/components/manager-attendance-review.tsx
@@ -108,7 +108,7 @@ export function AttendanceReviewSurface({
   const rows = ready ? groupRows(ready.groups, ready.labels) : [];
 
   return (
-    <section className="attendance-review" aria-labelledby="attendance-review-title">
+    <section className="attendance-review" aria-labelledby="attendance-review-title" data-attendance-state={paused ? "paused" : denied ? "unauthorized" : ready ? "ready" : unavailable ? "unavailable" : "loading"}>
       <ConfiguredAttendancePolicies />
       <header className="attendance-review-header">
         <div>
-- 
2.52.0

