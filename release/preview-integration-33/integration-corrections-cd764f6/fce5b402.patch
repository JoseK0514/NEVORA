Subject: [PATCH] TC-WA-16: use coordinator pending contrast without a kit
 override

---
 src/components/kit/kit.css | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/src/components/kit/kit.css b/src/components/kit/kit.css
index b8c2bc41..4d40cb01 100644
--- a/src/components/kit/kit.css
+++ b/src/components/kit/kit.css
@@ -342,6 +342,3 @@ a.nv-row:active { background: var(--nv-inset); }
   .nv-card { box-shadow: 0 0 0 1px var(--nv-ink); }
   .nv-masthead { background: var(--nv-masthead); }
 }
-
-/* TC-WA16: disabled kit colours already express pending state; do not fade their contrast. */
-html body .app-shell.nevora-portal .page-frame .nv-btn:is(:disabled, [aria-disabled="true"]) { opacity: 1; }
