html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .manager-corrections > .nv-link, html body .app-shell.nevora-portal .premium-home-view .manager-attendance-stack > .nv-link { padding-inline: var(--nv-s-5); }

/* Phase 7 round 2 */
/* WR-37: totals wrap instead of running together. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowTotals"] { flex-wrap: wrap; row-gap: 4px; column-gap: 16px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowTotals"] > div { display: flex; gap: 6px; align-items: baseline; }
/* WR-28: at large text the overview counts reflow, and names break between words only. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__overview"] { grid-template-columns: repeat(auto-fit, minmax(min(100%, 6.5rem), 1fr)); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowIdentity"] h2 { word-break: normal; overflow-wrap: break-word; hyphens: manual; }
@media (max-width: 400px) { html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowMain"] { grid-template-columns: 40px minmax(0, 1fr); } html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowMain"] > :not([class$="__rowSelect"]) { grid-column: 2; grid-row: auto; justify-self: start; } html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowMain"] > [class$="__rowSelect"] { grid-column: 1; grid-row: 1; } }
/* Timecards issue notes: kit inset, not a grey card. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__issues"] { border: 0; border-radius: var(--nv-r-control); background: var(--nv-inset); font: var(--nv-t-callout); }
/* WR-24: Timecards counts are in the overview card; the band says when approval opens. */
/* WR-33: kit buttons on Payroll and Schedule. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-button.pw-button { border-radius: var(--nv-r-control); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page :is(.button.primary, .button.secondary, .schedule-generation-action) {
  min-height: 48px; padding: 0 var(--nv-s-4); border-radius: var(--nv-r-control); font: var(--nv-t-label); font-weight: 600; box-shadow: none;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page .button.primary { border: 0; background: var(--nv-accent); color: #FFFFFF; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page :is(.button.secondary, .schedule-generation-action:not(.primary)) { border: 0; background: var(--nv-canvas); color: var(--nv-ink); box-shadow: inset 0 0 0 1px var(--nv-border); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page :is(.button, .schedule-generation-action):disabled { opacity: 1; background: var(--nv-inset); color: var(--nv-muted); box-shadow: inset 0 0 0 1px var(--nv-hairline); }
/* WR-10, AL-35..37: Schedule cards share one 20px inner edge and kit surfaces. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page :is(.mws-toolbar, .mws-planning > summary, .mws-planning-body, .mws-roster-heading, .mws-roster-row) { padding-left: var(--nv-s-5); padding-right: var(--nv-s-5); }
  html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-person { padding-left: 0; padding-right: 0; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation { margin-left: var(--nv-s-5); margin-right: var(--nv-s-5); max-width: calc(100% - 40px); padding-inline: 4px; }
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-period-control { min-height: 48px; border: 1px solid var(--nv-border); border-radius: var(--nv-r-control); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-period-control strong { font: var(--nv-t-label); font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented { padding: 4px; background: var(--nv-inset); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-planning > summary strong { font: var(--nv-t-headline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-planning > summary small { font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page :is(.schedule-generation-controls, .schedule-publication-controls) { border: 0; border-radius: var(--nv-r-control); background: var(--nv-inset); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation button span { font-size: .9375rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-shift-day { font: var(--nv-t-label); }
/* Payroll remnants: kit type and no boxes in boxes. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page :is(.pw-step-label, .pw-stepper-hint, .pw-payday-title, .pw-backlog-period small, .pw-backlog-period p) { font: var(--nv-t-callout); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page :is(.pw-net, .pw-import-format, .pw-lines, .pw-source) { border: 0; border-radius: var(--nv-r-control); background: var(--nv-inset); box-shadow: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-toolbar { justify-content: flex-start; text-align: left; }
/* WR-04: the Inbox pill row shows that it scrolls. */
html body .app-shell.nevora-portal .page-frame [data-nv-page] .nv-masthead .nv-filters[data-overflow="true"] { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent); padding-right: 28px; scroll-padding-inline: 16px 28px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-filter { min-width: 44px; justify-content: center; }
/* WR-42, AL-33, AL-34: Team's band and status pills keep one row at 320. */
html body .app-shell.nevora-portal .premium-team .nv-pageband__eyebrow-row { flex-wrap: nowrap; }
html body .app-shell.nevora-portal .premium-team .nv-pageband__eyebrow-row > .nv-masthead__eyebrow { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
html body .app-shell.nevora-portal .premium-team .nv-band-control { flex: none; white-space: nowrap; }
html body .app-shell.nevora-portal .premium-team-status { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--nv-s-5)); padding-inline: var(--nv-s-5); -webkit-mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 24px), transparent); mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 24px), transparent); }
html body .app-shell.nevora-portal .premium-team-status::-webkit-scrollbar { display: none; }
/* WR-40: a Next up button stays a button-sized target on wide screens. */
@media (min-width: 761px) and (not ((max-height: 430px) and (orientation: landscape) and (pointer: coarse))) { .nv-nextup .nv-btn { align-self: flex-start; min-width: 240px; max-width: 360px; } }
/* WR-41: landscape shows the band summary in full (a clamp cut longer summaries, Wave B AL). */
@media (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal .page-frame [data-nv-page] .nv-masthead__summary { display: block !important; }
}
/* AL-32, WR-16, WR-43, AL-24: the More sheet is one full-width bottom sheet, its Close sits after the list. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal :is(#manager-more-navigation, #employee-more-navigation):popover-open {
    inset: auto 0 0 0 !important; width: auto !important; max-width: 560px; margin: 0 auto !important; max-height: calc(100dvh - 24px); border-radius: 24px 24px 0 0;
  }
  /* WR4-09: Close stays in view at the sheet's foot when the list is taller than the sheet (Owner with Profile at 390). */
  html body .app-shell.nevora-portal.nevora-portal :is(#manager-more-navigation, #employee-more-navigation) .mobile-workforce-sheet-close { position: sticky; bottom: 0; z-index: 1; background-color: var(--nv-canvas, #FFFFFF); box-shadow: 0 16px 0 var(--nv-canvas, #FFFFFF), 0 -8px 8px -8px rgb(28 28 28 / .12); }
  html body .app-shell.nevora-portal.nevora-portal #manager-more-navigation .nevora-action-menu-divider { margin-inline: 0; }
}
/* AL-10: the Waiting pill sits on the card title's baseline. */
.nv-card__head > .nv-card__meta .nv-status { position: relative; top: 2px; }
/* AL-38: review facts start level with their label. */
.premium-review .nv-row:not(:has(.nv-row__chev)) { align-items: flex-start; }
/* AL-42: even toast padding. */
html body .app-shell.nevora-portal:not(.nv-shell-none) .nevora-toast { padding: 8px 8px 8px 16px; }
@media (max-width: 340px) { .premium-wide-only { display: none; } }

/* Phase 7 round 3 */
/* WR-45: a single breadcrumb has no leading separator. */
@media (min-width: 761px) and (max-width: 1100px) { html body .app-shell.nevora-portal .portal-location li:last-child::before { content: none; display: none; } }
/* WR-10, WR-33, WR-46: the rest of Schedule on kit sizes and surfaces. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented :is(a, a *) { font: var(--nv-t-label); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented a.selected, html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented a.selected * { font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-unscheduled > summary { min-height: 44px; font: var(--nv-t-label); color: var(--nv-accent); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation { border: 0; background: var(--nv-inset); border-radius: var(--nv-r-control); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation button { border-radius: var(--nv-r-inner); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-shift { border-radius: var(--nv-r-inner); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-utilities :is(.nevora-action-menu-trigger, .button) { min-height: 48px; border-radius: var(--nv-r-control); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-period-control { min-width: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-period-control > div { min-width: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-period-control strong { white-space: normal; text-align: center; text-wrap: balance; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-week-summary { grid-template-columns: repeat(auto-fit, minmax(min(100%, 6.5rem), 1fr)); }
/* WR-10, WR-14: Payroll's smaller text at the 15px floor; no bordered boxes inside panels. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page :is(.pw-tabs a, .pw-panel-heading p, .pw-toolbar p, label, .pw-small, small, .pw-state p, .pw-run-option strong, .pw-totals dt, .pw-source strong, .pw-source p, .pw-employee-amount summary strong, .pw-employee-amount summary span, .pw-lines div, .pw-backlog-period strong, .pw-backlog-period span, code) { font-size: .9375rem; line-height: 1.25rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page :is(.pw-totals div, .pw-run-option, .pw-recovery) { border: 0; border-radius: var(--nv-r-control); background: var(--nv-inset); box-shadow: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-run-option[aria-pressed="true"], html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-run-option.selected { box-shadow: inset 0 0 0 2px var(--nv-accent); background: var(--nv-accent-wash); }

/* Phase 7 round 3, stability and alignment */
.premium-band-aside { margin: 0; }
html body .app-shell.nevora-portal .page-frame .premium-home-view .nv-pageband__bar { min-height: 44px; }
/* ST-04: in landscape the toast sits at the top, clear of the decision and the tab bar. */
@media (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .nevora-toaster, html body:has([data-nv-page] .nv-actionbar) .nevora-toaster { top: calc(76px + env(safe-area-inset-top, 0px)); bottom: auto; }
  /* ST-20: no bounce or sideways drift on landscape phones either. */
  html:has(.app-shell.nevora-portal), html:has(.app-shell.nevora-portal) body { overflow-x: clip; overscroll-behavior: none; }
}
/* ST-16: Attendance's explainer loads last, so it sits after the content instead of pushing it. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review > details.panel { order: 9; }
/* ST-17: the loading rows are as tall as the real ones. */
.premium-skeleton--rows .premium-skeleton__row { min-height: 128px; }
/* AL-10: the pill's mark grows with the text; it rides on the title's baseline at any size. */
.nv-status svg { width: .875em; height: .875em; }
.nv-card__head > .nv-card__meta .nv-status { top: .125rem; }
/* AL-24: one spacing above every group label in the More sheet. */
html body .app-shell.nevora-portal.nevora-portal #manager-more-navigation .nevora-more-search-divider { margin: 0 0 4px; }
/* AL-29: the checkbox centres on the name's first line; the pill keeps inside the text edge. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] label[class$="__rowSelect"] { margin-top: -11px; align-self: start; }
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowMain"] { padding-right: 16px; }
}
/* AL-35: the roster's count line on the cards' text edge. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-result-summary { padding-left: var(--nv-s-5); padding-right: var(--nv-s-5); }
/* AL-36, AL-37: chip and day strips start and stop on whole items. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented { scroll-snap-type: none; scroll-padding-inline: 4px 28px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation { scroll-snap-type: none; scroll-padding-inline: 16px 24px; }

/* AL-38: review labels and values share a baseline. */
.premium-review .nv-row:not(:has(.nv-row__chev)) { align-items: baseline; }
/* AL-42: even toast insets. */
html body .app-shell.nevora-portal:not(.nv-shell-none) .nevora-toast { padding: 8px 10px 8px 16px; }
/* AL-43: Payroll's toolbar line starts on the edge like everything else. */
/* AL-P3-27: these are for the stacked phone toolbar only; in a row (landscape and up) the status line centres on the buttons. */
@media (max-width: 600px) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-toolbar { align-items: stretch; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-toolbar > p { justify-content: flex-start; align-self: flex-start; }
}
/* AL-44: a 44px link in a card head keeps its target without stretching the head. */
.nv-card__head .nv-card__meta .nv-link { min-height: 0; padding-block: 12px; margin-block: -12px; }

/* ST-05, AL-39: placeholder bands match each page's real band at each width (measured Oct 18). */
.route-skeleton[data-route="home"] { --route-band: 220px; }
.route-skeleton[data-route="inbox"] { --route-band: 308px; }
.route-skeleton[data-route="schedule"] { --route-band: 244px; }
.route-skeleton[data-route="team"] { --route-band: 220px; }
.route-skeleton[data-route="timecards"] { --route-band: 148px; }
.route-skeleton[data-route="payroll"] { --route-band: 152px; }
.route-skeleton[data-route="exports"] { --route-band: 128px; }
.route-skeleton[data-route="review"] { --route-band: 264px; }
@media (max-width: 389px) { .route-skeleton[data-route="inbox"] { --route-band: 332px; } }
@media (max-width: 359px) {
  .route-skeleton[data-route="home"] { --route-band: 256px; }
  .route-skeleton[data-route="team"] { --route-band: 244px; }
  .route-skeleton[data-route="exports"] { --route-band: 152px; }
}
@media (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  .route-skeleton:is([data-route="home"], [data-route="schedule"], [data-route="team"]) { --route-band: 172px; }
  .route-skeleton[data-route="inbox"] { --route-band: 260px; }
  .route-skeleton[data-route="timecards"] { --route-band: 140px; }
  .route-skeleton:is([data-route="payroll"], [data-route="exports"]) { --route-band: 96px; }
  .route-skeleton[data-route="review"] { --route-band: 216px; }
}
/* Time exports: kit cards under the band. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-exports [class*="payroll-export-module"][class$="__card"],
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-exports [class*="payroll-export-module"][class*="__card "] { border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); }

/* Phase 7 round 2, interaction */
/* IS-13: press and hover on every control; a selected pill stays white when pressed. */
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-masthead .nv-filter:is([aria-pressed="true"], [aria-current="page"]):active { background: #E3EFEE; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-masthead .nv-filter:not([aria-pressed="true"]):not([aria-current="page"]):not(:disabled):hover { background: rgba(255, 255, 255, .16); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-masthead .nv-filter:not([aria-pressed="true"]):not([aria-current="page"]):not(:disabled):active { background: rgba(255, 255, 255, .24); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-group > details > summary.nv-row:hover { background: #F7F9F8; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-group > details > summary.nv-row:active { background: var(--nv-inset); }
html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-header :is(button, a):hover { background: rgba(255, 255, 255, .1); }
html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-header :is(button, a):active { background: rgba(255, 255, 255, .18); }
html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .page-frame > .section-tabs .section-tab:hover { color: #FFFFFF; }
html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .page-frame > .section-tabs .section-tab:active { background: rgba(255, 255, 255, .1); }
/* IS-31: the notification state reads on the teal header. */
html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-header .portal-notification-unavailable { background: transparent; color: var(--nv-masthead-ink); }
/* IS-35: Apply is for keyboards and no-script use; it appears when focused. */
.sr-only-focusable:not(:focus-visible) { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
/* IS-40: the explainer shows it opens, and zero counts are plain text, not boxes. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review > details.panel > summary { list-style: none; gap: 6px; cursor: pointer; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review > details.panel > summary::-webkit-details-marker { display: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review > details.panel > summary::after { content: ""; width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform var(--nv-m-quick) var(--nv-ease-out); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review > details.panel[open] > summary::after { transform: translateY(2px) rotate(-135deg); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-summary > * { border: 0 !important; background: transparent !important; box-shadow: none !important; padding: 0 !important; min-height: 0 !important; }
/* ST-16: Attendance's two panels hold their loaded height while their reads arrive. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review { min-height: 27rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .manager-corrections { min-height: 16rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-header { min-height: 6.25rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-empty { min-height: 4.5rem; }

/* Phase 7 round 2, type and copy */
/* TC-33: the Team band keeps its count noun; on a narrow band the control says "Add". */
html body .app-shell.nevora-portal .premium-team .nv-pageband__eyebrow-row { container-type: inline-size; }
@container (max-width: 21rem) { .premium-band-wide { display: none; } }
/* TC-36: Inbox group titles are never cut. */
html body .app-shell.nevora-portal .premium-group .nv-row__title { -webkit-line-clamp: unset; display: block; }
/* TC-35: both setup steps read at one size. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-link { font: var(--nv-t-row); color: var(--nv-accent); }
/* TC-40: Schedule's counts read label first, like every other stat card. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-week-summary dt { order: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-week-summary dd { order: 1; margin-top: auto; }
/* TC-39: the publish panel and the payroll stepper at the 15px floor. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page :is(.schedule-generation-controls, .schedule-publication-controls) :is(p, small, span, label, li, dt, dd) { font-size: .9375rem; line-height: 1.25rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page :is(.pw-stepper, .pw-stepper-wrap) :is(span, small, p, li, strong) { font-size: .9375rem; line-height: 1.25rem; }
/* TC-34: on phones a review fact always sits under its label, so every row has one shape. */
@media (max-width: 430px) {
  .premium-review .nv-row:not(:has(.nv-row__chev)) { flex-direction: column; align-items: flex-start; gap: 2px; }
  .premium-review .nv-row:not(:has(.nv-row__chev)) .nv-row__trail { justify-content: flex-start; }
  .premium-review .premium-fact { text-align: left; }
}
/* TC-41: Attendance's freshness line reads like the kit stamp. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer :is(strong, time) { font-weight: 400; color: var(--nv-muted); }

/* Phase 7 alignment round 4 */
/* AL-38: stacked review facts keep their natural height. */
@media (max-width: 430px) { .premium-review .nv-row:not(:has(.nv-row__chev)) .nv-row__trail { flex: none; } }
/* AL-46, AL-48: the week stays on one line, and the Back row ends on the band's text edge in every view. */
.premium-week-eyebrow > span { white-space: nowrap; font: var(--nv-t-label); color: var(--nv-masthead-ink); }
.premium-week-eyebrow { margin-right: -13px; }
/* AL-24: the same 4px above every group label in More. */
html body .app-shell.nevora-portal.nevora-portal #manager-more-navigation .nevora-more-search-divider { margin: 0 0 2px; }
/* AL-29: at 401-760px the checkbox centres on the name line, and the state stays inside the text edge. */
@media (min-width: 401px) and (max-width: 760px) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] label[class$="__rowSelect"] { margin-top: -8px; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowMain"] { padding-right: 20px; }
}
/* AL-45: in landscape the Schedule strips span the card, and shift cards start on the text edge. */
@media (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page :is(.mws-day-navigation, .schedule-location-control .segmented) { width: auto; max-width: none; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-cell { padding-inline: 0; }
}
/* AL-49: Time exports' text buttons stay on one line. */
html body .app-shell.nevora-portal .premium-exports [class*="payroll-export-module"][class$="__textButton"] { white-space: nowrap; }
/* AL-50: Time exports' last panel is a kit card with the 20px inset. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-exports section.panel { margin: 0; padding: var(--nv-s-5); border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); }

/* Phase 7 widths round 4 */
/* WR-10: Schedule's location names at the label size (the old 13px rule was stronger). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented.segmented a.segmented-link, html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented.segmented :is(a, a > span) { font-size: .9375rem; line-height: 1.25rem; }
/* WR-10: Payroll's import heading and stepper hint on kit type and surfaces. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page :is(.pw-import-format, .pw-import-format *) { font-size: .9375rem; line-height: 1.25rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-stepper-hint { border: 0; border-radius: var(--nv-r-control); background: var(--nv-inset); }
/* WR-48: the freshness dot sits on the text line. */
/* WR-47: Time exports below the first card, on kit type, controls and surfaces. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-exports [class*="payroll-export-module"] :is(p, small, span, label, li, dt, dd, td, th, strong, summary) { font-size: max(.9375rem, 1em); line-height: 1.35; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-exports [class*="payroll-export-module"] :is(h2, h3) { font: var(--nv-t-headline); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-exports [class*="payroll-export-module"][class$="__count"] { display: inline-flex; align-items: center; min-height: 28px; padding: 0 var(--nv-s-3); border-radius: var(--nv-r-pill); background: var(--nv-neutral-fill); color: var(--nv-neutral-ink); font: var(--nv-t-label); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-exports [class*="payroll-export-module"] :is(button, a[class$="__button"], a[class$="__download"]) { min-height: 44px; border-radius: var(--nv-r-control); font: var(--nv-t-label); font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-exports [class*="payroll-export-module"] :is(input, select) { min-height: 48px; border: 1px solid var(--nv-field-border, var(--nv-border)); border-radius: var(--nv-r-control); background: var(--nv-canvas); font: var(--nv-t-body); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-exports [class*="payroll-export-module"]:is([class$="__notice"], [class$="__periodHint"], [class$="__receipt"], [class$="__totals"], [class$="__selectionBar"]) { border: 0; border-radius: var(--nv-r-control); background: var(--nv-inset); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-exports [class*="payroll-export-module"][class$="__hours"] { display: flex; flex-wrap: wrap; column-gap: 16px; row-gap: 4px; }
/* WR-49: one form field style on every Manager and Owner page: white, 1px border, 12px corners, 48px tall. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is(input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]):not([type="search"]), select) {
  min-height: 48px; box-sizing: border-box; border: 1px solid var(--nv-field-border, var(--nv-border)); border-radius: var(--nv-r-control); background-color: var(--nv-canvas);
}
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page .mws-search { border: 1px solid var(--nv-field-border, var(--nv-border)); background: var(--nv-canvas); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page .mws-search input { min-height: 46px; border: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-team .premium-field--search input { background: var(--nv-canvas); border-color: var(--nv-border); }

/* Phase 7 round 3, stability and interaction */
/* ST-16: Attendance holds its header height at narrow widths too. */
@media (max-width: 360px) { html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-header { min-height: 9.25rem; } }
/* ST-17: loading rows as tall as the real "Also needs you" rows. */
.premium-skeleton--rows .premium-skeleton__row { min-height: 150px; }
/* IS-13: Search, the bell and the setup link answer hover and press. */
html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .mobile-header :is(button, a):hover { background: rgba(255, 255, 255, .1); }
html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .mobile-header :is(button, a):active { background: rgba(255, 255, 255, .18); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-link:active { color: var(--nv-accent-strong); }
/* IS-44: a link inside a sentence keeps a 44px target without changing the line. */
html body .app-shell.nevora-portal .premium-exports p a { display: inline-block; padding-block: 12px; margin-block: -12px; }

/* Phase 7 type round 3 */
/* TC-33: the Team eyebrow wraps at large text instead of cutting its noun. */
html body .app-shell.nevora-portal .premium-team .nv-pageband__eyebrow-row > .nv-masthead__eyebrow { white-space: normal; overflow: visible; text-overflow: clip; }
/* TC-43: on a narrow band at large text, the week drops under Back instead of leaving the screen. */
html body .app-shell.nevora-portal .page-frame .premium-home-view .nv-pageband__bar { flex-wrap: wrap; row-gap: 0; }
html body .app-shell.nevora-portal .page-frame .premium-home-view .premium-week-eyebrow { margin-left: auto; }
/* TC-25: on wide screens a shift's time range sits on two deliberate lines. */
@media (min-width: 761px) { html body .app-shell.nevora-portal .manager-schedule-page .mws-shift strong > span { display: block; } }
/* TC-39: the publish panel at the 15px floor; its headings at the headline size. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page :is(.schedule-generation-controls, .schedule-publication-controls) :where(*):not(svg):not(svg *) { font-size: .9375rem; line-height: 1.25rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page :is(.schedule-generation-controls, .schedule-publication-controls) :is(h2, h3, h4, legend) { font: var(--nv-t-headline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page :is(.pw-import-format, .pw-import-format summary, .pw-import-format summary *) { font-size: .9375rem; line-height: 1.25rem; }
/* AL-45: Schedule's older cards drop their 1px border, so every card shares one text edge and one surface. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page :is(.mws-roster, .mws-planning, .schedule-operations-shell > .mws-toolbar) { border: 0; box-shadow: var(--nv-e1); }

/* Phase 7 widths round 5, interaction round 4 */
/* IS-43, WR-48: the freshness dot sits on the "Updated" line; the 30s note goes underneath. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer > div::before { content: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer > div > small { display: block; font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer > div > small::before { content: ""; display: inline-block; width: 6px; height: 6px; margin-right: 6px; border-radius: 3px; background: var(--nv-done-mark); vertical-align: 2px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer > div > small > span { display: block; }
/* WR-47: Time exports' selection note gets the full width; its buttons wrap beneath it. */
html body .app-shell.nevora-portal .premium-exports [class*="payroll-export-module"][class$="__selectionBar"] { flex-wrap: wrap; row-gap: var(--nv-s-2); }
html body .app-shell.nevora-portal .premium-exports [class*="payroll-export-module"][class$="__selectionBar"] > :first-child { flex: 1 1 100%; min-width: 0; }
/* WR-49: text areas join the shared field style. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] textarea { border: 1px solid var(--nv-field-border, var(--nv-border)); border-radius: var(--nv-r-control); background-color: var(--nv-canvas); }
/* WR-51 (regression): Schedule's search is one field; the inner input has no box of its own. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page].manager-schedule-page .mws-search input { min-height: 46px; border: 0; border-radius: 0; background: transparent; padding: 0; }
/* WR-52: rows scrolled away from their start fade on both sides. */
html body .app-shell.nevora-portal .page-frame [data-nv-page] .nv-masthead .nv-filters[data-overflow="true"][data-start="true"] { -webkit-mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 28px), transparent); }
/* WR-53: on the narrowest phones the week pager takes the full row, so its dates stay on one line. */
@media (max-width: 360px) {
  html body .app-shell.nevora-portal .manager-schedule-page.premium-legacy-page .mws-toolbar { flex-wrap: wrap; row-gap: var(--nv-s-2); }
  html body .app-shell.nevora-portal .manager-schedule-page.premium-legacy-page .mws-week-navigation { flex: 1 1 100%; }
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-period-control strong { white-space: nowrap; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-team .premium-field--search input { min-height: 48px; border: 1px solid var(--nv-field-border, var(--nv-border)); border-radius: var(--nv-r-control); }

/* Phase 7 type round 4 */
/* TC-42: the count badge goes under the heading on phones, so the date range keeps the line width. */
@media (max-width: 760px) {
  html body .app-shell.nevora-portal .premium-exports [class*="payroll-export-module"][class$="__sectionHeading"] { flex-wrap: wrap; }
  html body .app-shell.nevora-portal .premium-exports [class*="payroll-export-module"][class$="__sectionHeading"] > div { flex: 1 1 calc(100% - 64px); min-width: 0; }
  html body .app-shell.nevora-portal .premium-exports [class*="payroll-export-module"][class$="__sectionHeading"] > [class$="__count"] { margin-left: 56px; }
}
/* TC-44: the selection count meets 4.5:1 on its inset. */
html body .app-shell.nevora-portal .premium-exports [class*="payroll-export-module"] :is([class$="__selectionBar"], [class$="__totals"]) :is(small, span) { color: var(--nv-muted); }
/* Team's search field joins the shared field style (the old 8px/52px rule was stronger). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page].premium-team .premium-field--search input[type="search"] { min-height: 48px; border: 1px solid var(--nv-field-border, var(--nv-border)); border-radius: var(--nv-r-control); background: var(--nv-canvas); }

/* AL-37: room after the last day so the strip can still start on a whole day (width set by the roster). */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation .mws-day-tail { flex: none; height: 1px; align-self: center; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation .mws-day-tail[hidden] { display: none; }

/* WR-49 (round 6): textareas and the search fields outside Schedule take the shared field style too.
   Doubled attribute and the :not() chain beat mobile-workforce.css:73 (0,7,3). Schedule's search keeps its borderless input inside its wrapper. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page][data-nv-page] :is(textarea, input[type="search"]):not(.mws-search input):not([class*="__search"] input):not([type="hidden"]):not([type="checkbox"]):not([type="radio"]) {
  min-height: 48px; box-sizing: border-box; border: 1px solid var(--nv-field-border, var(--nv-border)); border-radius: var(--nv-r-control); background-color: var(--nv-canvas);
}
/* AL (cross-area, IS round 5): the footer column centres its children, so the freshness block shrank 4px in from the card's text edge. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer > div { align-self: stretch; }
/* ST-16: the loading and "Nothing to review" texts differ by 2px at 360; one minimum height for both. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-empty { min-height: 74px; box-sizing: border-box; }
/* TC-45: the bell's bare "—" while the count is loading or unavailable says nothing on screen (the link's name already does). Every role since Phase 3. */
html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .portal-notification-bell .portal-notification-unavailable { display: none; }
/* WR-55: one text size inside every field (17px on phones, 16px on desktop), Schedule's search included. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page][data-nv-page] :is(input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]), select, textarea):not(.nv-x) { font: var(--nv-t-body); }
/* WR-55: date and number fields grew to 50–54px from their own padding; every single-line field is exactly 48px. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page][data-nv-page] :is(input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]):not([type="search"]), select):not(.nv-x) { height: auto; min-height: 3rem; padding-block: var(--nv-s-2); }
/* WR-56: Schedule's search wrapper is 48px like every other field (mobile-workforce.css:122 made it 52). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .manager-schedule-page .mws-search, html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page .mws-search { min-height: 48px; height: 48px; box-sizing: border-box; }
/* TC-48: the freshness dot says the state: green live, grey while checking, a coral ring when it can't update. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer > div > small[data-state="checking"]::before { background: var(--nv-neutral-mark); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer > div > small[data-state="stale"]::before { background: transparent; box-shadow: inset 0 0 0 1.5px var(--nv-urgent-mark); }
/* IS-46: one focus ring on Schedule's search: the field shows it, the inner input doesn't. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page .mws-search input:is(:focus, :focus-visible) { outline: none; }
/* TC-47: day buttons are one width that scales with text (44px at 100%), so large text never outgrows them. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation button:not(:first-child) { flex: 0 0 auto; min-width: 2.75rem; padding-inline: 4px; box-sizing: border-box; }
/* IS-48: "Full week" grows with large text like the day buttons (72px at 100%). */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) { html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation button:first-child { flex: 0 0 4.5rem; width: 4.5rem; min-width: 4.5rem; box-sizing: border-box; } }
/* ST-24: the Today placeholder's "Loading…" sits in a box as wide as the loaded "Updated 12:00 PM" stamp. */
.premium-meta-hold { display: inline-grid; }
.premium-meta-hold > * { grid-area: 1 / 1; justify-self: start; }
.premium-meta-hold__ghost { visibility: hidden; }
/* AL-53: the in-portal error state is a kit page for every role (employees since Phase 3). */
.premium-error .nv-card__body { padding-top: var(--nv-s-5); }
.premium-error__text { margin: 0; font: var(--nv-t-body); color: var(--nv-muted); }
.premium-error__actions { display: flex; flex-wrap: wrap; gap: var(--nv-s-3); margin-top: var(--nv-s-5); }
@media (max-width: 359px) { .premium-error__actions .nv-btn { flex: 1 1 100%; } }
/* TC-50: offline, paused and no access show one footer line; the footer keeps its two-line height (ST-23). */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer > div > small { min-height: 2lh; }
/* Error pages: balance the two-line title so no word is left alone. */
.premium-error .nv-masthead__title { text-wrap: balance; }
/* AL-55: the same 8px gap between days at every width. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation { gap: 8px; }
/* AL-54: one 12px gap between side-by-side buttons (the kit's action bar), on Timecards, Time exports and Schedule too. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is([class*="timecards-module"][class*="__toolbar"], [class*="payroll-export-module"][class*="__toolbar"], .schedule-generation-peers) { gap: 12px; }
/* AL-55: above phones the strip's track starts on the page's 20px text edge too (it was 24). */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation { margin-left: var(--nv-s-5); }
/* TC-52: the error card sentence is body type (mobile-workforce.css:68 made it 15px). */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-error .premium-error__text { font: var(--nv-t-body); }
/* ST-25: a failed Home read keeps the loading shapes; the rows stand still and the button space is held. */
.premium-skeleton--still :is(.premium-skeleton__dot, .premium-skeleton__line) { animation: none; opacity: .6; }
.premium-skeleton__button--hold { visibility: hidden; }
.premium-pending-failed .nv-nextup__main .premium-note { margin: 0; }
/* ST-25: the failed Next up holds the placeholder's 60px main row (a 40px dot beside two lines). */
.premium-pending-failed .nv-nextup__main { min-height: 60px; align-items: center; }
/* IS-52: above phones "Full week" uses kit label type, which scales with text size (it was a fixed 12px), and grows with it. */
@media (min-width: 761px) and (not ((max-height: 430px) and (orientation: landscape) and (pointer: coarse))) { html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation button:first-child { flex: 0 0 auto; min-width: 5.75rem; font: var(--nv-t-label); white-space: nowrap; } }
/* AL-55: above phones the roster heading starts on the same 20px edge as the strip and the result line. */
@media (min-width: 761px) and (not ((max-height: 430px) and (orientation: landscape) and (pointer: coarse))) { html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-roster-heading { padding-inline: var(--nv-s-5); } }
/* AL-54: Payroll's button rows use the same 12px gap. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow .pw-actions { gap: var(--nv-s-3); }
/* WR-60: with the 12px gap, Timecards' two-column period toolbar needs half minus 6px (it was half minus 5 for a 10px gap).
   IS-56: one column once a column would be under 9rem, so a full date fits beside its calendar icon (320). */
@media (max-width: 760px) { html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="timecards-module"][class*="__toolbar"] { grid-template-columns: repeat(auto-fit, minmax(max(9rem, calc(50% - 6px)), 1fr)); } }
/* AL-54: Schedule's "Templates" and "More" sit 12px apart like every other button pair. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-utilities { column-gap: var(--nv-s-3); }
/* AL-56: the Inbox status line now leads its card (ST-26), so it starts on the card's 20px inset with no extra top margin. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .inbox-status.inbox-status > p:first-child { margin: 0 0 var(--nv-s-2); }
/* ST-27: Try again sits in the Today card's head and lays out like the text stamp it replaces (one 20px line);
   an invisible overlay makes its target 44px tall. */
.premium-today-retry { position: relative; display: inline; padding: 0; border: 0; background: none; color: var(--nv-accent); font: var(--nv-t-callout); font-weight: 600; cursor: pointer; }
.premium-today-retry::after { content: ""; position: absolute; inset: -12px -8px; }
.premium-today-retry svg { margin-right: var(--nv-s-1); vertical-align: -3px; }
@media (hover: hover) { .premium-today-retry:hover:not(:disabled):not([aria-disabled="true"]) { color: var(--nv-accent-hover); text-decoration: underline; } }
.premium-today-retry:disabled { color: var(--nv-muted); cursor: default; }
.premium-today-retry:focus-visible { outline: 2px solid var(--nv-accent); outline-offset: 4px; border-radius: 4px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home .premium-today-retry { display: inline-block; min-height: 0; min-width: 0; height: 1.25rem; line-height: 1.25rem; vertical-align: baseline; }
/* WR-61: one "couldn't load" card everywhere: a white kit card with a primary Try again (Payroll's wording is unchanged). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state, html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state.pw-state-error { gap: var(--nv-s-3); padding: var(--nv-s-5); border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state svg { color: var(--nv-icon); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state .pw-button { min-height: 52px; margin-top: var(--nv-s-4); padding: 0 var(--nv-s-5); border: 0; border-radius: var(--nv-r-control); background: var(--nv-accent); color: #FFFFFF; font: var(--nv-t-headline); box-shadow: none; outline-offset: 2px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state .pw-button:hover { background: var(--nv-accent-hover); color: #FFFFFF; }
/* IS-57: the Today retry's ring sits 4px out (the general content focus rule is 2px). */
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-content .premium-today-retry:focus-visible { outline: 2px solid var(--nv-accent); outline-offset: 4px; border-radius: 4px; }
.premium-today-retry[aria-disabled="true"] { color: var(--nv-muted); cursor: default; }
/* AL-57: Payroll's state icon is centred on its title line (22px, no top margin). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state > svg { width: 22px; height: 22px; margin-top: 0; }
/* TC-53: kit type on the two new state elements (the legacy phone rules had set 17px and 15/24). */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home .premium-today-retry { font: var(--nv-t-callout); font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-inbox .inbox-status.inbox-status > p { font: var(--nv-t-body); color: var(--nv-muted); }
/* TC-54 / WR-62: Payroll's failure card reads like the others: kit title and text, no alert icon (wording unchanged). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state > svg { display: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state strong { font: var(--nv-t-headline); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state p { margin: var(--nv-s-1) 0 0; font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state .pw-button { display: inline-flex; align-items: center; gap: var(--nv-s-2); }
/* AL-58: Payroll's Try again icon is 18px like every other (portal-gusto.css:158 makes legacy button icons 20px on phones). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state .pw-button svg { width: 18px; height: 18px; margin: 0; }
/* TC-57: busy "Trying…" reads as inactive: muted, no underline, even after a tap. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home .premium-today-retry[aria-disabled="true"] { color: var(--nv-muted); text-decoration: none; cursor: default; }
/* TC-56: the refresh icon inside Payroll's Try again takes the button's white, not the grey state-icon colour. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .payroll-workflow.premium-legacy-page .pw-state .pw-button svg { color: currentColor; }
/* WR-64: with no button (offline, paused) the Next up slot shows as the same still placeholder as the rows. */
.premium-skeleton__button--still { opacity: .6; animation: none; }
/* IS-58: Attendance's busy Refresh looks like its disabled state but keeps keyboard focus. */
/* TC-58: busy reads like the kit's disabled buttons: muted text (5.84:1) on white with the border, no fade. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-refresh:is([aria-disabled="true"], :disabled) { cursor: default; opacity: 1; color: var(--nv-muted); background: var(--nv-canvas); box-shadow: inset 0 0 0 1px var(--nv-border); }
/* WR-64 / ST-28: while Home holds the "needs you" column at its last height, Next up keeps its size and the last card fills the rest. */
.premium-home__now[data-holding] > :first-child { flex: none; }
.premium-home__now[data-holding] > :last-child:not(:first-child) { flex: 1 1 0; min-height: 0; overflow: hidden; }
/* WR-64: a held Next up keeps its last height; its message row absorbs the difference. */
.premium-home__now[data-holding] > .nv-nextup .nv-nextup__main { flex: 1 1 auto; min-height: 0; overflow: hidden; }

/* ===== Phase 3 (2026-10-19): employee Home on the kit. The pass overlaps the band (D-1 A); every other section is a kit card. ===== */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home { background: var(--nv-bg); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home > .nv-content { margin-top: calc(-1 * var(--nv-overlap)); padding: 0 var(--nv-gutter) var(--nv-s-12); gap: var(--nv-s-4); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home > .nv-content > div { gap: var(--nv-s-4); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home .premium-band-link { display: inline-flex; align-items: center; min-height: 44px; color: #FFFFFF; font: var(--nv-t-label); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home .nv-masthead__extra { margin-top: var(--nv-s-2); }
/* Cards: the pass keeps its green; the rest are white kit cards. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home :is([data-pass], aside[aria-label="Own recorded time"], [data-home-group]) { border-radius: var(--nv-r-card); box-shadow: var(--nv-e1); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home :is(aside[aria-label="Own recorded time"], [data-home-group]) { padding: var(--nv-s-5) var(--nv-s-5) var(--nv-s-2); background: var(--nv-canvas); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home [data-home-group] > header h2 { font: var(--nv-t-title-3); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home [data-home-group] > header > span { font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home [data-home-group] li a strong { font: var(--nv-t-row); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home [data-home-group] li a small { font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home [data-home-group] li a { border-color: var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home nav[aria-labelledby="employee-home-quick"] > h2 { margin: var(--nv-s-2) 0 var(--nv-s-3); font: var(--nv-t-title-3); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home nav[aria-labelledby="employee-home-quick"] li a { border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); color: var(--nv-accent); font: var(--nv-t-label); font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home footer[class] small { font: var(--nv-t-callout); color: var(--nv-muted); }
/* Phase 3: Requests overview. The help is a quiet kit card disclosure. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-request-hub .request-hub-help { margin: 0; padding: 0 var(--nv-s-5); border: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-request-hub .request-hub-help > summary { display: flex; align-items: center; justify-content: space-between; gap: var(--nv-s-3); min-height: 56px; font: var(--nv-t-row); color: var(--nv-ink); cursor: pointer; list-style: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-request-hub .request-hub-help > summary::-webkit-details-marker { display: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-request-hub .request-hub-help[open] > summary svg { transform: rotate(180deg); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-request-hub .request-hub-help-content { display: grid; gap: var(--nv-s-2); padding: 0 0 var(--nv-s-5); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-request-hub .request-hub-help-content p { margin: 0; font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-request-hub .request-hub-help-content a { display: inline-flex; align-items: center; gap: var(--nv-s-1); min-height: 44px; color: var(--nv-accent); font: var(--nv-t-label); font-weight: 600; }
/* Phase 3: employee pages built on the kit share one content column under the band. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-content { display: flex; flex-direction: column; gap: var(--nv-s-4); padding: var(--nv-s-5) var(--nv-gutter) var(--nv-s-12); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-card-lead { margin: 0 0 var(--nv-s-4); font: var(--nv-t-callout); color: var(--nv-muted); }
/* Time off: one row per request, with its status tag and a two-step timeline. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-timeoff-list { margin: 0; padding: 0; list-style: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-timeoff-row { display: flex; flex-direction: column; gap: var(--nv-s-1); padding: var(--nv-s-4) var(--nv-s-5); }
