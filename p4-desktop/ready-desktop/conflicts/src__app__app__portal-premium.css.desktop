html body .app-shell.nevora-portal .employee-time-footer-placeholder { visibility: hidden; }
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  /* P3-ST-06: on phones My time's footer stacks (stamp lines, then controls), so "Checking…" and "Refresh" can't rewrap it. */
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .employee-time-panel .employee-time-footer:not(#nv-kit) { flex-direction: column; flex-wrap: nowrap; align-items: flex-start; gap: var(--nv-s-2); }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .employee-time-panel .employee-time-footer > :is(small, .employee-time-controls):not(#nv-kit) { flex: none; }
}
/* P3-ST-13: an employee page that is a grid with a minimum height packs its rows at the top; the spare height
 * must never stretch the band (Timecards' band was 245px until its content loaded). */
html body .app-shell.employee-shell.nevora-portal .page-frame [data-nv-page] { align-content: start; }

/* ===== Phase 3, Phase 7 round 2 (alignment). ===== */
/* AL-P3-02 / AL-P3-13: Notifications rows and their date heading start at the 20px card inset; the tile is 40 with a 12 gap (text at 88). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__groups"] { padding-left: 0; padding-right: 0; }
