html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .nto-withdrawal form > label > input[type="checkbox"] { flex: none; width: 22px; height: 22px; margin: 0; accent-color: var(--nv-accent); }
