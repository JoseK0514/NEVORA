/* ===== Phase 3, round 3 (widths and roles). ===== */
/* P3-WR-07: Availability decides for the whole list. When the longest day and its switch can't share a line, every row stacks. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .av-day-list { container-type: inline-size; }
@container (max-width: 15.5rem) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .av-day-row > .av-availability-toggle { flex-basis: 100%; margin-left: 0; }
}
/* P3-WR-08: on phones every Time off request has one layout: the pill under the dates, then one timeline event per line. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-timeoff-row__head { flex-direction: column; align-items: flex-start; gap: var(--nv-s-2); }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-timeline { flex-direction: column; gap: var(--nv-s-1); }
}
/* P3-WR-11: at 200% text, labels wrap inside their card instead of running past its edge. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .nv-row .nv-status { white-space: normal; max-width: 100%; }
