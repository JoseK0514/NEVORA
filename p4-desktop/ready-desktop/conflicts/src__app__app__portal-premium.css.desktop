html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] a[class*="notification-inbox-module"][class*="__row"] { grid-template-columns: 40px minmax(0, 1fr) auto; column-gap: var(--nv-s-3); padding-left: var(--nv-s-5); padding-right: var(--nv-s-5); border-radius: 0; }
@media (max-width: 600px) { html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] a[class*="notification-inbox-module"][class*="__row"] { grid-template-columns: 40px minmax(0, 1fr); } }
/* Updates rows: the same 40 tile, 12 gap. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .updates-row { column-gap: var(--nv-s-3); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .update-kind-icon { width: 40px; height: 40px; border-radius: 20px; }
@media (max-width: 760px) { html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .updates-row { grid-template-columns: 40px minmax(0, 1fr) 18px; padding-left: var(--nv-s-5); padding-right: var(--nv-s-5); } }
/* Profile: the Work details tile is a kit tile; settings rows put their 20px icon at the inset with a 12 gap (text at 68). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .profile-icon-tile { width: 40px; height: 40px; border-radius: 20px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .profile-settings-list :is(.profile-setting-row, .profile-signout-row), html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .profile-signout-row { padding-left: var(--nv-s-5); padding-right: var(--nv-s-5); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .profile-setting-note { padding-left: calc(var(--nv-s-5) + 20px + var(--nv-s-3)); padding-right: var(--nv-s-5); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .profile-setting-copy > svg { width: 20px; height: 20px; }
/* My pay's privacy note starts at the page edge like the other notes. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page].premium-employee-pay .pw-privacy, html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .premium-employee-pay .pw-privacy, html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-pay .pw-privacy:not(#nv-kit) { padding-left: 0; padding-right: 0; }
/* AL-P3-03: My time and Timecards keep the kit's 16 between band and first card; Notifications' lead line sits in the 16 rhythm. */
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame :is(.premium-employee-time, .premium-employee-timecards).employee-view:not(#nv-kit),
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame :is(.premium-employee-time, .premium-employee-timecards) .employee-my-time-view:not(#nv-kit) { gap: 0; }
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame .employee-corporate-timecards:not(#nv-kit) { gap: var(--nv-s-4); }
html body .app-shell.nevora-portal.nevora-portal .page-frame :is(.nv-content, .premium-employee-content) > .premium-card-lead { margin: 0; }
/* AL-P3-04: My schedule's blocks sit in the 16 rhythm; an empty side column takes no gap. */
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame .premium-employee-schedule :is(.my-review-jump, .my-schedule-feedback, .my-schedule-changes .schedule-publication-change):not(#nv-kit) { margin: 0; }
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame .premium-employee-schedule .my-schedule-side:not(:has(> *:not(:empty))) { display: none; }
/* AL-P3-06 / AL-P3-11: the status pill aligns to the heading's text; the heading's icon is centred, so it doesn't set the baseline. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is(.employee-time-section-heading, .employee-time-current-heading) > h2 { align-items: baseline; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is(.employee-time-section-heading, .employee-time-current-heading) > h2 > :is(svg, .my-time-section-icon) { align-self: center; }
/* AL-P3-12: the Timecards "Draft" pill sits on the title's baseline. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .employee-corporate-timecard > header, html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="timecards-module"][class*="__card"] > header { align-items: baseline; }
/* AL-P3-15: below 390 the week strip has equal 10px insets; where it still scrolls, it fades at the edge it continues past. */
@media (max-width: 389px) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-schedule .my-week-days { padding-inline: 10px; margin-inline: -20px; scroll-padding-inline: 10px; scroll-snap-type: x proximity; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-schedule .my-week-day { scroll-snap-align: start; }
}
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-schedule .my-week-days[data-overflow="true"] { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-schedule .my-week-days[data-overflow="true"][data-start="true"] { -webkit-mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 28px), transparent); }
/* AL-P3-16: Home's cards are kit cards in landscape and on desktop too: no border under the shadow. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home :is([data-pass], aside[aria-label="Own recorded time"], [data-home-group]):not(#nv-kit) { border: 0; }

/* ===== Phase 3, automated checks (Oct 19). ===== */
/* My schedule's swap prompt and feedback sit on the kit roles. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .my-schedule-feedback > strong { display: block; font: var(--nv-t-headline); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .my-schedule-feedback > p { font: var(--nv-t-callout); color: var(--nv-muted); }
/* "This shift can't change" notes on Shift requests are callout text, not 12px. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .shift-change-unavailable { font: var(--nv-t-callout); }
/* The withdraw confirmation: the whole label is the 44px target, with a 22px checkbox. */
