html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-timeoff .nv-card .nto-form-footer { display: flex; flex-direction: column-reverse; gap: var(--nv-s-3); margin: var(--nv-s-5) 0 0; padding: var(--nv-s-5) 0 0; border-top: 1px solid var(--nv-hairline); }
