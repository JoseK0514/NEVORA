/* Premium direction, phase 2 (2026-10-18): how kit pages sit inside the app shell.
 * Pages opt in with a PageBand (data-nv-band). Phase 3 (2026-10-19) extends the shell rules to the employee app;
 * ":not(.nv-shell-none)" keeps the selector weight the employee stylesheets were outranked by. Loaded after every portal sheet. */

/* Phones (and short landscape phones): the shell header and the page band are one teal surface. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):has([data-nv-band]) .mobile-header {
    background: var(--nv-masthead); border: 0; box-shadow: none; padding: 12px var(--nv-gutter); min-height: 68px;
  }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):has([data-nv-band]) .mobile-header :is(.login-brand-lockup, .portal-workspace-name) { color: #FFFFFF; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):has([data-nv-band]) .mobile-header .login-brand-module { color: var(--nv-masthead-ink); }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):has([data-nv-band]) .mobile-header :is(.portal-notification-bell, .portal-header-notifications, .nevora-action-menu-trigger, .command-finder-trigger, button, a) {
    color: #FFFFFF; background: transparent; border-color: transparent;
  }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):has([data-nv-band]) .mobile-header :is(a, button):focus-visible { outline: 2px solid #FFFFFF; outline-offset: 2px; }
  /* The band runs edge to edge; the canvas ends above the tab bar. */
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame:has([data-nv-page]) { padding: 0; background: var(--nv-bg); }
  /* ST-WA-6: 20px clear of the tab bar at any text size (the bar is 52px plus its 1rem label). */
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame [data-nv-page] { padding-bottom: calc(72px + 1rem + env(safe-area-inset-bottom, 0px)); }
  /* Section tabs on a band page belong to the band. */
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame:has([data-nv-page]) > .section-tabs {
    margin: 0; padding: 0 var(--nv-gutter); border: 0; background: var(--nv-masthead);
  }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame:has([data-nv-page]) > .section-tabs .section-tab { color: var(--nv-masthead-ink); }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame:has([data-nv-page]) > .section-tabs .section-tab[aria-current="page"] { color: #FFFFFF; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame:has([data-nv-page]) > .section-tabs .section-tab[aria-current="page"]::after { background: #FFFFFF; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame:has([data-nv-page]) > .section-tabs .section-tab:focus-visible { outline-color: #FFFFFF; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .app-main:has([data-nv-page]) { background: var(--nv-bg); }

  /* Tab bar: icon over label, the selected tab marked by a pill behind its icon.
   * The pill is drawn by a pseudo-element, so the selected tab never moves its icon or label. */
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav {
    left: 0; right: 0; bottom: 0; margin: 0; width: auto;
    padding: 6px 4px calc(6px + env(safe-area-inset-bottom, 0px));
    border: 0; border-top: 1px solid var(--nv-hairline); border-radius: 0; background: rgba(255, 255, 255, .96);
    -webkit-backdrop-filter: saturate(1.4) blur(16px); backdrop-filter: saturate(1.4) blur(16px);
    box-shadow: none;
  }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link {
    position: relative; isolation: isolate; min-height: 52px; padding: 6px 0 4px; gap: 6px;
    border-radius: 0; background: transparent; color: var(--nv-muted); font-weight: 500; box-shadow: none;
    font-size: min(.8125rem, 15px); line-height: 1.25; letter-spacing: .01em;
  }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link::before {
    content: ""; position: absolute; z-index: -1; top: 1px; left: 50%; width: 60px; height: 32px; margin-left: -30px;
    border-radius: 16px; background: var(--g-accent-select, #CDE7E5); opacity: 0; transform: scaleX(.6);
    transition: opacity var(--nv-m-quick) var(--nv-ease-out), transform var(--nv-m-base) var(--nv-ease-out);
  }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link.active { color: var(--nv-accent-strong); font-weight: 600; background: transparent; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link.active::before { opacity: 1; transform: none; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link svg { color: inherit; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link:focus-visible { outline: 2px solid var(--nv-accent); outline-offset: -2px; border-radius: 12px; }
}

/* Wider screens (not landscape phones): the band sits inside the page frame as a rounded panel (desktop work is phase 4). */
@media (min-width: 761px) and (not ((max-height: 430px) and (orientation: landscape) and (pointer: coarse))) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page][data-nv-page] { max-width: 1120px; margin-inline: 0; width: 100%; } /* AL4-10: left edge, as the trail and older pages (D1: nothing is centred) */
  html body .app-shell.nevora-portal .page-frame [data-nv-page] > .nv-pageband { border-radius: 20px; padding-inline: 36px; }
  html body .app-shell.nevora-portal .page-frame [data-nv-page] > :is(.nv-content, form.nv-content) { padding-inline: 16px; }
  html body .app-shell.nevora-portal .page-frame [data-nv-page] .nv-actionbar { margin-inline: -16px; padding-inline: 16px; }
  /* WR-06: one grey canvas behind kit pages. */
  html body .app-shell.nevora-portal :is(.app-main, .page-frame):has([data-nv-page]) { background: var(--nv-bg); }
  /* WR-21: a single decision stays readable on a wide screen. */
  html body .app-shell.nevora-portal .page-frame .premium-review > :is(.nv-content, form.nv-content) { max-width: 720px; margin-inline: auto; width: 100%; box-sizing: border-box; }
  /* WR-09: on wide screens the Schedule toolbar starts below the band, not across its edge. */
  html body .app-shell.nevora-portal .page-frame .manager-schedule-page > .nv-pageband { padding-bottom: var(--nv-s-6); }
  html body .app-shell.nevora-portal .page-frame .manager-schedule-page > .nv-content { margin-top: var(--nv-s-4); }
}
/* WR-08: a narrow desktop bar shows only the current place, so it never runs under Search. */
@media (min-width: 761px) and (max-width: 1100px) {
  html body .app-shell.nevora-portal .portal-location li:not(:last-child) { display: none; }
  html body .app-shell.nevora-portal .portal-location-nav { min-width: 0; overflow: hidden; }
  html body .app-shell.nevora-portal .portal-location li:last-child { overflow: hidden; text-overflow: ellipsis; }
}
/* WR-05: landscape phones keep the wordmark, a shorter band and phone geometry. */
@media (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal .mobile-header > .brand { display: flex; }
  html body .app-shell.nevora-portal .page-frame [data-nv-page] { --nv-overlap: 32px; }
  html body .app-shell.nevora-portal .page-frame [data-nv-page] .nv-masthead__summary { display: none; }
  html body .app-shell.nevora-portal .page-frame [data-nv-page] .nv-masthead .nv-masthead__title { font: var(--nv-t-title-2); }
  /* WR-02: the Schedule toolbar doesn't stick over the header in landscape. */
  html body .app-shell.nevora-portal .schedule-operations-shell { position: static; }
}
/* WR-01: Timecards' toolbar never squeezes its buttons on tablet widths. */
@media (min-width: 761px) and (max-width: 1180px) {
  html body .app-shell.nevora-portal .premium-legacy-page [class*="timecards-module"][class$="__toolbar"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  html body .app-shell.nevora-portal .premium-legacy-page [class*="timecards-module"][class$="__toolbar"] button { width: 100%; }
}
/* WR-07: the roster's hidden helpers stay inside its scroller. */
html body .app-shell.nevora-portal .premium-legacy-page .mws-roster-content { position: relative; }
/* WR-20: at large text the decision buttons stack instead of clipping; band controls wrap. */
.nv-actionbar { flex-wrap: wrap; }
.nv-actionbar > .nv-btn { flex: 1 1 9rem; }
.nv-pageband__eyebrow-row { flex-wrap: wrap; }

@media (prefers-reduced-motion: reduce) {
  html body .app-shell.nevora-portal .mobile-nav .mobile-nav-link::before { transition: none !important; }
}
@media (forced-colors: active) {
  html body .app-shell.nevora-portal .mobile-nav .mobile-nav-link.active::before { background: Highlight; forced-color-adjust: none; }
}

/* Home (phase 2) */
.premium-note { margin: 0 0 var(--nv-s-3); font: var(--nv-t-callout); color: var(--nv-muted); }
.premium-note:last-child { margin-bottom: 0; }
.premium-home__grid > div { display: flex; flex-direction: column; gap: var(--nv-s-4); }
.premium-week-foot { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: var(--nv-s-3); flex-wrap: wrap; }
.premium-week-foot .nv-link { min-height: 44px; }
.premium-home .nv-card__foot { display: flex; align-items: center; min-height: 52px; padding-block: 4px; }
.premium-home .nv-card > .nv-progress:first-of-type { padding-top: var(--nv-s-2); }
.premium-home .nv-card > .nv-progress + .nv-progress { border-top: 1px solid var(--nv-hairline); padding-top: var(--nv-s-4); }
.premium-home .nv-card > .nv-progress:last-of-type { padding-bottom: var(--nv-s-4); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup > * { margin: 0; }
/* Owner "Finish setting up": the card's own markup and links, in kit form. */
html body .app-shell.nevora-portal .premium-home__setup .owner-setup-card,
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-card { padding: var(--nv-s-5); border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); color: var(--nv-ink); }
html body .app-shell.nevora-portal .page-frame .premium-home__setup .owner-setup-card h2,
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-card h2 { margin: 0; font: var(--nv-t-headline); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-count { margin: var(--nv-s-1) 0 0; font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-count > span { font-weight: 600; color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-progress { display: block; height: 6px; margin: var(--nv-s-3) 0 var(--nv-s-2); border-radius: var(--nv-r-bar); background: var(--nv-track); overflow: hidden; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-progress > span { display: block; height: 100%; border-radius: var(--nv-r-bar); background: var(--nv-accent); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-steps { display: grid; margin: 0; padding: 0; list-style: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-step { display: grid; grid-template-columns: 20px minmax(0, 1fr); column-gap: var(--nv-s-3); align-items: start; padding: var(--nv-s-2) 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-step + .owner-setup-step { border-top: 1px solid var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-mark { margin-top: 12px; color: var(--nv-icon); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-step[data-state="done"] .owner-setup-mark { color: var(--nv-done-mark); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-done-row strong { font-weight: 500; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-done-row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--nv-s-3); min-height: 44px; margin: 0; padding: 10px 0 0; font: var(--nv-t-row); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-done { font: var(--nv-t-label); font-weight: 600; color: var(--nv-done-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-link { display: inline-block; padding: 12px 0; font: var(--nv-t-label); color: var(--nv-accent); text-decoration: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-link:hover { color: var(--nv-accent-hover); text-decoration: underline; text-underline-offset: 3px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-nowrap { white-space: nowrap; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-nowrap svg { margin-left: 2px; vertical-align: -2px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home__setup .owner-setup-open p { margin: 0; font: var(--nv-t-callout); color: var(--nv-muted); }
.premium-skeleton__line, .premium-skeleton__figure { display: block; border-radius: 6px; background: var(--nv-inset); }
.premium-skeleton__line { height: 14px; width: 70%; margin: 6px 0; }
.premium-skeleton__figure { height: 30px; width: 40%; }
@media (prefers-reduced-motion: no-preference) {
  .premium-skeleton__line, .premium-skeleton__figure { animation: premium-pulse 1.4s var(--nv-ease-inout) infinite alternate; }
}
@keyframes premium-pulse { from { opacity: 1; } to { opacity: .55; } }
@media (min-width: 1024px) {
  .premium-home__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-areas: "now today" "now setup" "now week" "now ."; grid-template-rows: auto auto auto 1fr; align-items: start; }
  .premium-home__setup { grid-area: setup; }
  .premium-home__now { grid-area: now; }
  .premium-home__today { grid-area: today; }
  .premium-home__week { grid-area: week; }
}
@media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav { background: #FFFFFF; -webkit-backdrop-filter: none; backdrop-filter: none; }
}

/* Band text keeps its colours against older page-level heading rules. */
html body .app-shell.nevora-portal .page-frame .nv-masthead .nv-masthead__title { margin: var(--nv-s-1) 0 0; color: #FFFFFF; font: var(--nv-t-title-1); letter-spacing: -.022em; }
html body .app-shell.nevora-portal .page-frame .nv-masthead .nv-masthead__eyebrow { margin: 0; color: var(--nv-masthead-ink); font: var(--nv-t-label); }
html body .app-shell.nevora-portal .page-frame .nv-masthead .nv-masthead__eyebrow .nv-fresh { color: var(--nv-masthead-ink); font: inherit; }
html body .app-shell.nevora-portal .page-frame .nv-masthead .nv-masthead__summary { margin: var(--nv-s-2) 0 0; color: var(--nv-masthead-ink); font: var(--nv-t-body); }
html body .app-shell.nevora-portal .page-frame .nv-card .nv-card__title { margin: 0; color: var(--nv-ink); font: var(--nv-t-headline); }
html body .app-shell.nevora-portal .page-frame .nv-filter { padding: 0 14px; }

/* Focused review (F6) */
.premium-fact { font: var(--nv-t-row); color: var(--nv-ink); text-align: right; }
.premium-review .nv-row__title { color: var(--nv-muted); font: var(--nv-t-label); }
.premium-review .nv-row:has(.nv-row__chev) .nv-row__title, .premium-review a.nv-row .nv-row__title { color: var(--nv-ink); font: var(--nv-t-row); }
.premium-review-note { margin: 0; padding: 0 var(--nv-s-5) var(--nv-s-5); font: var(--nv-t-body); color: var(--nv-ink); }
.premium-review-more { margin: 0 0 var(--nv-s-4); padding: 0 var(--nv-s-5); }
.premium-review-error { margin: 0; }
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  /* The decision sits just above the tab bar. */
  .premium-review .premium-review-actions { --nv-actionbar-offset: calc(66px + env(safe-area-inset-bottom, 0px)); padding-bottom: var(--nv-s-3); }
}
/* The focused review is one task: no section tabs above its band. */
html body .app-shell.nevora-portal .page-frame:has(.premium-review) > .section-tabs { display: none; }
.premium-review .premium-review-actions { margin-top: auto; }

/* Older pages on a band: their own cards overlap it, nothing else changes. */
.premium-legacy-content > * { margin-top: 0; margin-bottom: 0; min-width: 0; max-width: 100%; }
html body .app-shell.nevora-portal .page-frame [data-nv-page] { min-width: 0; max-width: 100%; box-sizing: border-box; }
html body .app-shell.nevora-portal .page-frame [data-nv-page] > .nv-content { min-width: 0; }
.premium-legacy-content > :is(.form-error, .form-success, .form-warning) { margin: 0; }

/* More sheet groups (MG3) */
html body .app-shell.nevora-portal .nevora-more-group { display: flex; flex-direction: column; }
html body .app-shell.nevora-portal .nevora-more-group + .nevora-more-group { margin-top: var(--nv-s-2); padding-top: var(--nv-s-2); border-top: 1px solid var(--nv-hairline); }
html body .app-shell.nevora-portal .nevora-more-group-label { margin: 0; padding: var(--nv-s-2) 10px var(--nv-s-1); font: var(--nv-t-callout); font-weight: 600; color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal #manager-more-navigation :is(.nevora-action-menu-item, .nevora-more-search) { font: var(--nv-t-row); }
/* A short kit page still fills the screen with its canvas. */
@media (max-width: 760px) {
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame [data-nv-page] { min-height: calc(100dvh - 76px); }
  /* ST-WA-5: a section-tab row above the page counts too, so a short page doesn't scroll over nothing. */
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame:has(> .section-tabs) [data-nv-page] { min-height: calc(100dvh - 76px - 2.75rem); }
}
.premium-inbox .nv-card__body > .premium-note + .nv-link { margin-top: var(--nv-s-1); }

/* Phase 7: the kit wins over the older phone-wide rules inside kit pages
 * (mobile-workforce.css :is(button,a,label,legend) / :is(p,li,dt,dd), portal-design-system h2 and button heights). */
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-btn { min-height: 52px; font: var(--nv-t-headline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] :is(.nv-band-control, .nv-filter, .nv-link) { font: var(--nv-t-label); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-masthead__back { font: var(--nv-t-label); font-size: 1.0625rem; line-height: 1.375rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-filter[aria-pressed="true"],
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-filter[aria-current="page"] { font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] :is(.nv-row, .nv-stat) { font: inherit; line-height: normal; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] :is(.premium-note, .nv-reason, .inbox-section-note, .nv-nextup__body) { font: var(--nv-t-callout); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-nextup__label { font: var(--nv-t-label); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .premium-review-note { font: var(--nv-t-body); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-nextup .nv-nextup__title { margin: 0; font: var(--nv-t-title-3); letter-spacing: -.012em; color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-band-control { min-height: 44px; padding: 0 var(--nv-s-3); gap: 6px; font-weight: 500; border: 0; background: transparent; color: #FFFFFF; }
/* AL-12: group rows use the row gap. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-group > details > summary.nv-row { display: flex; gap: var(--nv-s-3); }
/* AL-16, AL-20: legacy pages keep the kit rhythm under the band. */
html body .app-shell.nevora-portal .page-frame .premium-legacy-page.premium-legacy-page { gap: 0; }
html body .app-shell.nevora-portal .page-frame .premium-legacy-content.premium-legacy-content > * { margin-block: 0; }
/* AL-26: section tabs on the band start on the band's text line. */
html body .app-shell.nevora-portal.nevora-portal .page-frame:has([data-nv-page]) > .section-tabs .section-tab { padding-inline: 0; }
/* AL-27: summaries stay clear of the watermark on phones. */
/* AL-27 and WR-44: on small phones the summary keeps its width; from 401px it stays clear of the watermark. */
@media (max-width: 400px) { .nv-pageband .nv-masthead__summary { max-width: min(36em, calc(100% - 40px)); } }
@media (min-width: 401px) and (max-width: 760px) { .nv-pageband .nv-masthead__summary { max-width: min(36em, calc(100% - 96px)); } }
/* TC-02: review facts wrap under their label instead of squeezing it. */
.premium-review .nv-row:not(:has(.nv-row__chev)) { flex-wrap: wrap; row-gap: 2px; }
.premium-review .nv-row:not(:has(.nv-row__chev)) .nv-row__text { flex: 0 0 auto; }
.premium-review .nv-row__trail { flex: 1 1 10rem; justify-content: flex-end; }
.premium-fact { white-space: normal; }

/* Phase 7: older content under a band, aligned to the kit's edges (scoped to band pages only). */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  /* AL-06: the Timecards period controls are a toolbar on the canvas, not an unpadded card. */
  html body .app-shell.nevora-portal[data-mobile-workforce="true"] .premium-legacy-page [class*="timecards-module"][class$="__periodPanel"] { padding: 0; border-radius: 0; background: transparent; box-shadow: none; }
  /* AL-07 */
  html body .app-shell.nevora-portal[data-mobile-workforce="true"] .premium-legacy-page [class*="timecards-module"][class$="__batch"] { padding: 16px 19px; }
  /* AL-08: one inset inside a payroll card; the bare toolbar sits on the gutter. */
  html body .app-shell.nevora-portal[data-mobile-workforce="true"] .premium-legacy-page .pw-panel .pw-panel-heading { padding: 0; margin-bottom: var(--nv-s-3); }
  html body .app-shell.nevora-portal[data-mobile-workforce="true"] .premium-legacy-page .pw-toolbar { padding: 0; }
  /* AL-18, AL-19: one inner inset per card. */
  html body .app-shell.nevora-portal[data-mobile-workforce="true"] .premium-legacy-page .mws-roster-heading { padding: 20px 16px; }
  html body .app-shell.nevora-portal[data-mobile-workforce="true"] .premium-legacy-page [class*="employee-directory-module"][class$="__toolbar"] { padding: 20px 16px; }

}
/* AL-24, AL-25: More sheet dividers on one inset; the last action never hides under Close. */
html body .app-shell.nevora-portal #manager-more-navigation .nevora-more-search-divider { margin: 0 0 7px; }
/* The whole sheet fits a phone without scrolling: 44px rows, tighter group spacing. */
html body .app-shell.nevora-portal.nevora-portal #manager-more-navigation :is(.nevora-action-menu-item, .nevora-more-search) { min-height: 44px; padding-block: 11px; }
html body .app-shell.nevora-portal.nevora-portal #manager-more-navigation .nevora-more-group + .nevora-more-group { margin-top: 4px; padding-top: 4px; }
html body .app-shell.nevora-portal.nevora-portal #manager-more-navigation .nevora-more-group-label { padding-top: 4px; padding-bottom: 0; }

/* Team (Phase 7 rebuild): kit fields, filters and rows. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-team-form { display: flex; flex-direction: column; gap: var(--nv-s-3); padding: 0 var(--nv-s-5) var(--nv-s-5); margin: 0; background: transparent; box-shadow: none; border-radius: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; font: var(--nv-t-label); color: var(--nv-ink-2); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-field :is(input, select) {
  box-sizing: border-box; width: 100%; min-height: 48px; padding: 0 var(--nv-s-3); border: 1px solid var(--nv-field-border, var(--nv-border)); border-radius: var(--nv-r-control);
  background: var(--nv-canvas); color: var(--nv-ink); font: var(--nv-t-body); text-overflow: ellipsis;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-field--search { position: relative; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-field--search svg { position: absolute; left: var(--nv-s-3); top: 14px; color: var(--nv-icon); pointer-events: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-field--search input { padding-left: 42px; background: var(--nv-inset); border-color: transparent; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-field :is(input, select):focus-visible { outline: 2px solid var(--nv-accent); outline-offset: 2px; }
html body .app-shell.nevora-portal .premium-team-selects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--nv-s-3); }
@media (max-width: 359px) { html body .app-shell.nevora-portal .premium-team-selects { grid-template-columns: 1fr; } }
html body .app-shell.nevora-portal .premium-team-status { margin: 0; padding: 0; flex-wrap: wrap; overflow: visible; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .premium-filter-light { gap: 6px; background: var(--nv-inset); color: var(--nv-ink-2); border: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .premium-filter-light[aria-pressed="true"] { background: var(--nv-accent-wash); color: var(--nv-accent-strong); box-shadow: inset 0 0 0 1px var(--nv-accent); }
html body .app-shell.nevora-portal .premium-filter-count { font-variant-numeric: tabular-nums; color: var(--nv-muted); }
html body .app-shell.nevora-portal .premium-filter-light[aria-pressed="true"] .premium-filter-count { color: var(--nv-accent-strong); }
html body .app-shell.nevora-portal .premium-team-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--nv-s-5); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .premium-apply { padding: 0; border: 0; background: transparent; cursor: pointer; }
html body .app-shell.nevora-portal .premium-team .premium-person-name { -webkit-line-clamp: unset; display: block; }
html body .app-shell.nevora-portal .premium-team-phone { display: none; }
@media (min-width: 761px) { html body .app-shell.nevora-portal .premium-team-phone { display: inline; } }
html body .app-shell.nevora-portal .premium-empty { display: flex; flex-direction: column; align-items: flex-start; gap: var(--nv-s-3); padding-top: var(--nv-s-5); }

/* Timecards under the band (Phase 7): the same workflow and controls, drawn with kit tokens.
 * Scoped to the Manager and Owner page; the employee timecard keeps its own look until phase 3. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] { gap: var(--nv-s-4); overflow-wrap: break-word; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] :is(dt, dd) { overflow-wrap: normal; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__toolbar"] label { font: var(--nv-t-label); color: var(--nv-ink-2); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__toolbar"] input[type="date"] {
  min-height: 48px; padding: 0 var(--nv-s-3); border: 1px solid var(--nv-field-border, var(--nv-border)); border-radius: var(--nv-r-control); background: var(--nv-canvas); font: var(--nv-t-body); color: var(--nv-ink);
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] :is(.button.primary, .button.secondary) {
  min-height: 48px; padding: 0 var(--nv-s-4); border-radius: var(--nv-r-control); font: var(--nv-t-label); font-weight: 600; box-shadow: none;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] .button.primary { border: 0; background: var(--nv-accent); color: #FFFFFF; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] .button.secondary { border: 0; background: var(--nv-canvas); color: var(--nv-ink); box-shadow: inset 0 0 0 1px var(--nv-border); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] .button:disabled { background: var(--nv-inset); color: var(--nv-muted); box-shadow: inset 0 0 0 1px var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__status"] { display: flex; align-items: center; gap: 6px; margin: 0; font: var(--nv-t-callout); color: var(--nv-muted); }
/* Period overview: one card of three counts. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__overview"] {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); overflow: hidden;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__overview"] > div { display: flex; flex-direction: column; gap: var(--nv-s-1); padding: var(--nv-s-3) var(--nv-s-4) var(--nv-s-4); border: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__overview"] > div:first-child { padding-left: var(--nv-s-5); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__overview"] > div + div { border-left: 1px solid var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__overview"] dt { order: 0; font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__overview"] dd { order: 1; margin: auto 0 0; font: var(--nv-t-title-2); color: var(--nv-ink); font-variant-numeric: tabular-nums; }
/* Selected-timecard review: a kit card. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__batch"] { padding: 0 var(--nv-s-5); border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__batchHeading"] { display: flex; align-items: center; gap: var(--nv-s-3); min-height: 60px; padding: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__batchHeading"] h2 { flex: 1; margin: 0; font: var(--nv-t-headline); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__selectionCount"] { padding: 2px 10px; border-radius: 999px; background: var(--nv-neutral-fill); font: var(--nv-t-label); color: var(--nv-neutral-ink); box-shadow: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] :is([class$="__guidance"], [class$="__note"]) { font: var(--nv-t-callout); color: var(--nv-muted); }
/* People: one card, one row per person. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rows"] { border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); overflow: hidden; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowHeader"] { padding-top: var(--nv-s-3); padding-bottom: var(--nv-s-3); border-bottom: 1px solid var(--nv-hairline); background: transparent; font: var(--nv-t-label); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__row"] { margin: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
@media (max-width: 760px) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__row"] { padding: var(--nv-s-4) 0; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowHeader"] { padding-left: 16px; padding-right: 16px; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowDetails"] { padding-left: 72px; padding-right: 16px; }
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__row"] + [class$="__row"] { border-top: 1px solid var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__row"][data-attention] { box-shadow: inset 3px 0 0 var(--nv-urgent-mark); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowIdentity"] h2 { margin: 0; font: var(--nv-t-row); color: var(--nv-ink); white-space: normal; overflow: visible; text-overflow: clip; }
/* State as a kit pill: a condition with a mark. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page :is([class*="__managerRoot"], .employee-corporate-timecards) [class$="__state"]:not(#nv-kit) {
  display: inline-flex; align-items: center; gap: 6px; min-height: 28px; padding: 0 var(--nv-s-3); border: 0; border-radius: var(--nv-r-pill);
  background: var(--nv-neutral-fill); color: var(--nv-neutral-ink); font: var(--nv-t-label); text-transform: none; white-space: nowrap;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page :is([class*="__managerRoot"], .employee-corporate-timecards) [class$="__state"]:not(#nv-kit)::first-letter { text-transform: uppercase; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page :is([class*="__managerRoot"], .employee-corporate-timecards) [class$="__state"]:not(#nv-kit)::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 4px; box-shadow: inset 0 0 0 1.5px currentColor; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page :is([class*="__managerRoot"], .employee-corporate-timecards) [class$="__state"]:not(#nv-kit):is([data-state="APPROVED"], [data-state="FINALIZED"]) { background: var(--nv-done-fill); color: var(--nv-done-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page :is([class*="__managerRoot"], .employee-corporate-timecards) [class$="__state"]:not(#nv-kit):is([data-state="APPROVED"], [data-state="FINALIZED"])::before { background: currentColor; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowTotals"] dt { font: var(--nv-t-callout); color: var(--nv-muted); white-space: nowrap; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowTotals"] dd { margin: 0; font: var(--nv-t-label); font-weight: 600; color: var(--nv-ink); white-space: nowrap; font-variant-numeric: tabular-nums; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] :is([class$="__rowAttention"], [class$="__rowQuiet"]) { font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowAttention"][data-tone="warning"] { color: var(--nv-urgent-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__rowDetails"] > summary { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; font: var(--nv-t-label); color: var(--nv-accent); }
@media (max-width: 359px) { html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] [class$="__toolbar"] { grid-template-columns: 1fr; } }

/* Payroll under the band (Phase 7): the same panels, wording and controls, drawn with kit tokens.
 * Wording is unchanged: payroll copy keeps its approval. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-panel {
  margin: 0; padding: var(--nv-s-5); border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1);
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-panel-heading { padding: 0; margin: 0 0 var(--nv-s-3); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-panel-heading h2 { margin: 0; font: var(--nv-t-headline); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page :is(.pw-panel-heading p, .pw-panel > p, .pw-small, .pw-privacy, .pw-subheading, .pw-line-label) { font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-button {
  min-height: 48px; padding: 0 var(--nv-s-4); border: 0; border-radius: var(--nv-r-control); background: var(--nv-accent); color: #FFFFFF; font: var(--nv-t-label); font-weight: 600; box-shadow: none;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-button:hover:not(:disabled) { background: var(--nv-accent-hover); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-button.pw-secondary { background: var(--nv-canvas); color: var(--nv-ink); box-shadow: inset 0 0 0 1px var(--nv-border); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-button.pw-secondary:hover:not(:disabled) { background: #F7F9F8; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-button:disabled { opacity: 1; background: var(--nv-inset); color: var(--nv-muted); box-shadow: inset 0 0 0 1px var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-badge {
  gap: 6px; min-height: 28px; padding: 0 var(--nv-s-3); border-radius: var(--nv-r-pill); background: var(--nv-review-fill); color: var(--nv-review-ink); font: var(--nv-t-label); text-transform: none; letter-spacing: 0;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-badge::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 4px; background: currentColor; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-badge.pw-badge-success { background: var(--nv-done-fill); color: var(--nv-done-ink); }
/* Periods inside a panel are rows, not cards inside a card. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-backlog-period { padding: var(--nv-s-4) 0; border: 0; border-top: 1px solid var(--nv-hairline); border-radius: 0; background: transparent; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page :is(.pw-notice, .pw-error) { padding: var(--nv-s-3) var(--nv-s-4); border: 0; border-radius: var(--nv-r-control); font: var(--nv-t-callout); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-notice { background: var(--nv-inset); color: var(--nv-ink-2); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-error { background: var(--nv-urgent-fill); color: var(--nv-urgent-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--nv-s-3); margin: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .payroll-workflow.premium-legacy-page .pw-privacy { margin: 0; padding: 0 var(--nv-s-1); }

/* Schedule under the band (Phase 7): kit chips, one stat card, one search field, a day strip that shows it scrolls. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-week-summary {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin: 0; padding: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); overflow: hidden;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-week-summary > div { display: flex; flex-direction: column; align-items: flex-start; gap: var(--nv-s-1); padding: var(--nv-s-3) var(--nv-s-4) var(--nv-s-4); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-week-summary > div:first-child { padding-left: var(--nv-s-5); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-week-summary > div + div { border-left: 1px solid var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-week-summary dt { order: 1; font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-week-summary dd { order: 0; margin: 0; font: var(--nv-t-title-2); color: var(--nv-ink); font-variant-numeric: tabular-nums; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-status-chip {
  display: inline-flex; align-items: center; gap: 6px; min-height: 28px; padding: 0 var(--nv-s-3); border-radius: var(--nv-r-pill); font: var(--nv-t-label); white-space: nowrap;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented { border-radius: var(--nv-r-control); -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented a { border-radius: var(--nv-r-inner); font: var(--nv-t-label); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .schedule-location-control .segmented a.selected { font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-search { width: 100%; box-sizing: border-box; padding: 0 var(--nv-s-3); border-radius: var(--nv-r-control); background: var(--nv-inset); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-search input { flex: 1; width: auto; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; font: var(--nv-t-body); }
/* AL-55: the strip fades only on a side that has more days to scroll to. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation { -webkit-mask-image: none; mask-image: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation[data-more-end] { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation[data-more-start] { -webkit-mask-image: linear-gradient(to right, transparent, #000 16px); mask-image: linear-gradient(to right, transparent, #000 16px); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation[data-more-start][data-more-end] { -webkit-mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 24px), transparent); mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 24px), transparent); }

html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation button span { font-size: .8125rem; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page .mws-day-navigation button strong { font: var(--nv-t-label); font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .manager-schedule-page.premium-legacy-page :is(.mws-roster, .mws-planning, .schedule-operations-shell > .mws-toolbar) { border-radius: var(--nv-r-card); }

/* TC-15: "Workforce" under the wordmark at a readable 13px on band pages (it's part of the lockup). */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-header .login-brand-module { font-size: .8125rem; line-height: 1rem; letter-spacing: .08em; }
  /* WR-25: section tabs on the band show that they scroll instead of cutting a word at the edge. */
  html body .app-shell.nevora-portal.nevora-portal .page-frame:has([data-nv-page]) > .section-tabs .section-tabs-track { scroll-padding-inline: 28px; }
  
}

/* IS-1: focus on the teal band is white; on cards it is the action teal. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .nv-masthead :is(a, button, input, select, summary):focus-visible,
html body .app-shell.nevora-portal.nevora-portal .page-frame:has([data-nv-page]) > .section-tabs :is(a, button):focus-visible { outline: 2px solid #FFFFFF; outline-offset: 2px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-content :is(a, button, input, select, summary, [tabindex]):focus-visible { outline: 2px solid var(--nv-accent); outline-offset: 2px; }
/* IS-2: keyboard focus and jumps stop clear of the sticky decision bar on the review. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html:has(body .app-shell.nevora-portal .premium-review) { scroll-padding-block: 84px calc(176px + env(safe-area-inset-bottom)); }
}
/* IS-4: room for the focus ring inside scrolling pill rows. */
html body .app-shell.nevora-portal .page-frame [data-nv-page] .nv-filters { padding-block: 4px; margin-block: -4px; }
/* IS-13: every control answers a hover or a press. */
.nv-stat { transition: background-color var(--nv-m-press) linear; }
a.nv-stat:hover { background: #F7F9F8; }
a.nv-stat:active { background: var(--nv-inset); }
a.nv-stat[data-tone="urgent"]:hover { background: #FBEAE6; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-band-control:hover:not(:disabled),
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-masthead__back:hover { background: rgba(255, 255, 255, .1); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-band-control:active:not(:disabled),
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-masthead__back:active { background: rgba(255, 255, 255, .18); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-masthead__back { border-radius: var(--nv-r-control); padding-inline: var(--nv-s-2); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-masthead .nv-filter:not([aria-pressed="true"]):not([aria-current="page"]):hover { background: rgba(255, 255, 255, .16); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-masthead .nv-filter:active { background: rgba(255, 255, 255, .24); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .premium-filter-light:not([aria-pressed="true"]):hover { background: var(--nv-track); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-link:hover { color: var(--nv-accent-hover); text-decoration: underline; text-underline-offset: 3px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .nv-link:active { color: var(--nv-accent-strong); }
html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link:active::before { opacity: .6; transform: none; }
@media (prefers-reduced-motion: reduce) { .nv-stat { transition: none; } }
.premium-skeleton__row { display: flex; align-items: center; gap: var(--nv-s-3); padding: var(--nv-s-2) 0; }
.premium-skeleton__row > span:last-child { flex: 1; }
.premium-skeleton__dot { flex: none; width: 40px; height: 40px; border-radius: 20px; background: var(--nv-inset); }
.premium-skeleton__line--short { width: 45%; }
@media (prefers-reduced-motion: no-preference) { .premium-skeleton__dot { animation: premium-pulse 1.4s var(--nv-ease-inout) infinite alternate; } }
/* IS-12: each timecard checkbox has a 44px target that toggles it. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] label[class$="__rowSelect"] { display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; margin: -12px 0 -12px -12px; cursor: pointer; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-legacy-page [class*="__managerRoot"] label[class$="__rowSelect"] input { width: 22px; height: 22px; margin: 0; accent-color: var(--nv-accent); }

/* Toast (IS-25, IS-27): the kit's brand-ink toast for Managers and Owners, with a 44px dismiss. */
html body .app-shell.nevora-portal:not(.nv-shell-none) .nevora-toast { background: var(--nv-masthead-deep); color: #FFFFFF; border: 0; border-radius: var(--nv-r-control); box-shadow: var(--nv-e2); font: var(--nv-t-label); }
html body .app-shell.nevora-portal:not(.nv-shell-none) .nevora-toast > svg { color: #7FD6A8; }
html body .app-shell.nevora-portal:not(.nv-shell-none) .nevora-toast[data-tone="info"] > svg { color: var(--nv-masthead-ink); }
html body .app-shell.nevora-portal .nevora-toast > button { width: 44px; height: 44px; margin: -8px -8px -8px 0; border-radius: var(--nv-r-control); }
html body .app-shell.nevora-portal:not(.nv-shell-none) .nevora-toast > button { color: var(--nv-masthead-ink); }
html body .app-shell.nevora-portal:not(.nv-shell-none) .nevora-toast > button:hover { background: rgba(255, 255, 255, .12); color: #FFFFFF; }
html body .app-shell.nevora-portal:not(.nv-shell-none) .nevora-toast > button:focus-visible { outline: 2px solid #FFFFFF; outline-offset: 0; }
html body .app-shell.nevora-portal #main-content:focus:not(:focus-visible) { outline: none; }
html body .app-shell.nevora-portal #main-content:focus-visible { outline: none; }

/* ST-05: loading placeholders carry the band at its final height (Manager and Owner only). */
.route-skeleton-band { display: none; }
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame:has(> .route-skeleton[data-band]) { padding: 0; background: var(--nv-bg); }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton[data-band] { padding: 0 0 calc(88px + env(safe-area-inset-bottom, 0px)); background: var(--nv-bg); }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton[data-band] .route-skeleton-band {
    display: flex; flex-direction: column; justify-content: flex-start; gap: 12px; box-sizing: border-box; height: calc(var(--route-band) + var(--route-band-grow, 0px) * (var(--nv-text-scale, 1) - 1)); padding: 20px var(--nv-gutter) 0; background: var(--nv-masthead);
  }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton-band i { display: block; height: 16px; width: 38%; border-radius: 8px; background: rgba(255, 255, 255, .12); }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton-band i:nth-child(2) { height: 30px; width: 56%; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton-band i:nth-child(3) { width: 72%; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton[data-band] > :not(.route-skeleton-band):not(.sr-only) { margin-inline: var(--nv-gutter); }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton[data-band="overlap"] > .route-skeleton-band + * { margin-top: calc(-1 * var(--nv-overlap)); }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton[data-band="flat"] > .route-skeleton-band + * { margin-top: var(--nv-s-4); }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .route-skeleton[data-band] .route-skeleton-header { display: none; }
  /* ST-06: the phone header is teal from the first frame, landscape included. */
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .mobile-header { background: var(--nv-masthead); border: 0; box-shadow: none; padding: 12px var(--nv-gutter); min-height: 68px; -webkit-backdrop-filter: none; backdrop-filter: none; }
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .mobile-header :is(.login-brand-lockup, .portal-workspace-name) { color: #FFFFFF; }
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .mobile-header .login-brand-module { color: var(--nv-masthead-ink); }
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .mobile-header :is(.portal-notification-bell, .portal-header-notifications, .nevora-action-menu-trigger, .command-finder-trigger, button, a) { color: #FFFFFF; background: transparent; border-color: transparent; }
  /* ST-09: section tabs belong to the teal header from the first frame, with no colour fade. */
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .page-frame > .section-tabs { margin: 0; padding: 0 var(--nv-gutter); border: 0; background: var(--nv-masthead); }
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .page-frame > .section-tabs .section-tab { padding-inline: 0; color: var(--nv-masthead-ink); transition: none; }
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .page-frame > .section-tabs .section-tab::after { transition: none; }
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .page-frame > .section-tabs .section-tab[aria-current="page"] { color: #FFFFFF; }
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .page-frame > .section-tabs .section-tab[aria-current="page"]::after { background: #FFFFFF; }
  html body .app-shell.nevora-portal.nevora-portal[data-mobile-workforce="true"]:not(.nv-shell-none) .page-frame:has(> .section-tabs) > .route-skeleton[data-band] .route-skeleton-band { padding-top: 12px; }
  /* ST-12: 20px between the last card and the tab bar, not 69. */
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .page-frame [data-nv-page] > :is(.nv-content, form.nv-content) { padding-bottom: 0; }
  /* ST-13: a whole-pixel tab bar (68px) whose selected label keeps its width. */
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link { min-height: 55px; line-height: 1rem; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link.active { font-weight: 500; }
  /* ST-10: the More sheet runs to the bottom edge, so no half tab labels show beneath it. */
  html body .app-shell.nevora-portal.nevora-portal :is(#manager-more-navigation, #employee-more-navigation):popover-open { bottom: 0; left: 0; right: 0; margin: 0; width: auto; border-radius: 24px 24px 0 0; padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px)); }
  /* ST-03, ST-07: the decision bar docks just above the 68px tab bar; two buttons side by side at 320. */
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-review .nv-actionbar.premium-review-actions {
    position: fixed; left: 0; right: 0; bottom: calc(68px + env(safe-area-inset-bottom, 0px)); z-index: 20; margin: 0; padding: var(--nv-s-3) var(--nv-gutter); background: linear-gradient(rgba(242, 244, 243, 0), var(--nv-bg) 8px);
  }
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-review[data-nv-page] { padding-bottom: calc(68px + 76px + 16px + env(safe-area-inset-bottom, 0px)); }
  .nv-actionbar > .nv-btn { flex-basis: 8rem; }
  /* ST-04: a toast sits above the tab bar, and above any page's action bar when one is showing (Wave C, Oct 19: every wave's save bar). */
  html body .nevora-toaster { bottom: calc(80px + env(safe-area-inset-bottom, 0px)); }
  html body:has([data-nv-page] .nv-actionbar) .nevora-toaster { bottom: calc(68px + 76px + 8px + env(safe-area-inset-bottom, 0px)); }
}
/* ST-08, ST-14: landscape phones scroll the header away, keep the decision in the page, and respect the notch. */
@media (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-review .nv-actionbar.premium-review-actions { position: static; padding-inline: 0; background: none; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-review[data-nv-page] { padding-bottom: calc(88px + env(safe-area-inset-bottom, 0px)); }
  html body:has([data-nv-page] .nv-actionbar) .nevora-toaster { bottom: calc(80px + env(safe-area-inset-bottom, 0px)); }
  html body .app-shell.nevora-portal:not(.nv-shell-none) :is(.mobile-header, .nv-pageband, [data-nv-page] > .nv-content, [data-nv-page] > form.nv-content) {
    padding-left: max(var(--nv-gutter), env(safe-area-inset-left)); padding-right: max(var(--nv-gutter), env(safe-area-inset-right));
  }
  html body .app-shell.nevora-portal:not(.nv-shell-none) .mobile-nav { padding-left: max(4px, env(safe-area-inset-left)); padding-right: max(4px, env(safe-area-inset-right)); }
}
/* ST-01, ST-02: placeholders in their final shapes. */
.premium-skeleton-values .nv-stat__value { color: var(--nv-track); }
.premium-skeleton-card .nv-nextup__main { align-items: center; }
.premium-skeleton-lines { display: flex; flex: 1; flex-direction: column; gap: 8px; }
.premium-skeleton__button { display: block; height: 52px; border-radius: var(--nv-r-control); background: var(--nv-inset); }
.premium-skeleton--rows { padding: 0 var(--nv-s-5) var(--nv-s-3); }
.premium-skeleton--rows .premium-skeleton__row { min-height: 64px; }
/* P3-ST-21: larger text wraps the summary onto more lines, so its reserved lines scale with the text too. */
html body .app-shell.nevora-portal .premium-inbox .nv-masthead__summary { min-height: calc(3rem * var(--nv-text-scale, 1)); }
@media (max-width: 360px) { html body .app-shell.nevora-portal .premium-inbox .nv-masthead__summary { min-height: calc(4.5rem * var(--nv-text-scale, 1)); } }
html body .app-shell.nevora-portal .premium-inbox .nv-pageband__eyebrow-row { flex-wrap: nowrap; }
html body .app-shell.nevora-portal .premium-inbox .nv-pageband__eyebrow-row > .nv-masthead__eyebrow { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-inbox .nv-filter:disabled { opacity: .6; cursor: default; }

/* Home's other views (Phase 7, WR-38/39/40, AL-30/31): week arrows in the eyebrow, kit cards below. */
.premium-week-eyebrow { display: inline-flex; align-items: center; gap: 2px; margin-left: -12px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .premium-week-arrow { width: 44px; padding: 0; justify-content: center; margin: 0; }
.nv-card > .nv-stats + .nv-stats { border-top: 1px solid var(--nv-hairline); }
html body .app-shell.nevora-portal .premium-home-view .manager-attendance-stack { display: flex; flex-direction: column; gap: var(--nv-s-4); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review, .manager-corrections) {
  margin: 0; padding: var(--nv-s-5); border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1); color: var(--nv-ink);
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-header, .manager-corrections-header) { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--nv-s-2) var(--nv-s-3); margin: 0 0 var(--nv-s-3); padding: 0; border: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-header, .manager-corrections-header) :is(span, small, p) { font: var(--nv-t-callout); color: var(--nv-muted); text-transform: none; letter-spacing: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review, .manager-corrections) h2 { margin: 0; font: var(--nv-t-headline); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-summary { display: flex; flex-wrap: wrap; gap: var(--nv-s-2) var(--nv-s-5); margin: 0 0 var(--nv-s-3); padding: 0; border: 0; background: transparent; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-summary :is(strong, span, small) { font: var(--nv-t-callout); color: var(--nv-ink-2); text-transform: none; letter-spacing: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-summary strong { font-weight: 600; color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-row, .manager-correction-row) { margin: 0; padding: var(--nv-s-3) 0; border: 0; border-top: 1px solid var(--nv-hairline); border-radius: 0; background: transparent; box-shadow: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-avatar { width: 40px; height: 40px; border-radius: 20px; background: var(--nv-neutral-fill); color: var(--nv-neutral-ink); font: var(--nv-t-label); font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-person, .manager-correction-topline) :is(strong, h3) { font: var(--nv-t-row); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-signal, .manager-correction-reason, .manager-correction-provenance, .manager-correction-self, .attendance-review-limited, .attendance-review-footer, .attendance-review-empty, .manager-corrections-empty, .manager-corrections-notice) :is(span, small, p, strong),
