html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .manager-schedule-page.premium-legacy-page .schedule-period-control strong:not(#nv-kit) { min-width: 0; white-space: normal; text-align: center; }
/* P3-WR-13: in landscape, employee Home's band drops the review line (the To do card carries the count), like the Manager's 180px band. */
@media (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home [data-nv-band] :is(.premium-band-note, .nv-masthead__extra) { display: none; }
}
/* Shell: on phones the header's Search is an icon; its word stays for screen readers, so large text can't push it off-screen. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .mobile-header .command-finder-trigger span:not([class]) { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
}
/* P3-WR-14: Schedule's failure sits in the week card, in the card's own inset. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .my-schedule-failure { display: grid; justify-items: start; gap: var(--nv-s-2); padding: var(--nv-s-4) var(--nv-s-5) var(--nv-s-5); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .my-schedule-failure > strong { font: var(--nv-t-headline); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .my-schedule-failure > p { margin: 0 0 var(--nv-s-2); font: var(--nv-t-callout); color: var(--nv-muted); }
/* Notifications: when its read failed, the head's Try again is the page's primary action, like the other failure cards. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] button[class*="notification-inbox-module"][class*="__refresh"][data-retry]:not(#nv-kit):not(#nv-kit2) { min-height: 52px; padding: 0 var(--nv-s-5); background: var(--nv-accent); color: #FFFFFF; font: var(--nv-t-headline); }
/* F1: the phone Inbox tab's "needs you" count sits on the icon's corner, in the kit's urgent colour. */
html body .app-shell.nevora-portal.nevora-portal .mobile-nav .mobile-nav-link .mobile-nav-count { position: absolute; top: 2px; left: calc(50% + 4px); min-width: 20px; height: 20px; padding: 0 5px; border: 2px solid #FFFFFF; border-radius: var(--nv-r-pill); background: var(--nv-urgent-ink); color: #FFFFFF; font: var(--nv-t-badge); line-height: 16px; text-align: center; font-variant-numeric: tabular-nums; box-sizing: border-box; }
/* Kit buttons are never faded when disabled: the kit's disabled look (no brand fill, muted label) carries it.
 * portal-gusto's blanket 55% opacity made them 2.2:1 (Wave C, Oct 19). */
html body .app-shell.nevora-portal.nevora-portal .page-frame :is(.nv-btn, .nv-band-control):is(:disabled, [aria-disabled="true"]):not(#nv-kit) { opacity: 1; }
/* TC-P3-18: toasts and page messages read at the kit's 15px roles on phones, landscape included (they were 12–14px).
 * TC-P3-29: Availability's context lines use a kit role, so they grow with text size. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html:root body .nevora-toast,
  html:root body .app-shell.nevora-portal .page-frame .form-success[role="status"]:not(form *):not([popover] *):not(dialog *) { font: var(--nv-t-label); }
  html:root body .app-shell.nevora-portal .page-frame :is(.nto-page, .employee-timeoff-view, .employee-availability-view, .availability-page) :is(.form-error, .form-warning, .form-success:not([role="status"])),
  html:root body .app-shell.nevora-portal .availability-page .av-feedback { font: var(--nv-t-callout); }
  html:root body .app-shell.nevora-portal .availability-page :is(.av-week-context p, .av-week-context span:not(.av-icon-tile), .av-upcoming-banner :is(p, span), .av-deadline :is(p, span), .av-submission-detail :is(p, small)) { font: var(--nv-t-callout); }
  html:root body .app-shell.nevora-portal .availability-page :is(.av-deadline strong, .av-submission-detail strong) { font: var(--nv-t-label); font-weight: 600; }
}
/* ST-04 for the redirect toast too: in landscape it sits at the top, clear of the tab bar. */
@media (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html:root body .app-shell.nevora-portal .page-frame .form-success[role="status"]:not(form *):not([popover] *):not(dialog *) { top: calc(76px + env(safe-area-inset-top, 0px)); bottom: auto; }
}
/* TC-P3-28: employee section titles and text actions on kit roles, one role per level (the legacy page h2 at 550 and
 * the 17/25.5 link set still reached them). Section titles 19/25/600, sub-sections 17/22/600, text actions 15/20/500. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html:root body .app-shell.nevora-portal .page-frame [data-nv-page] :is(.employee-time-current-heading, .employee-time-section-heading, .profile-section-heading) h2:not(#nv-kit),
  html:root body .app-shell.nevora-portal .page-frame .premium-employee-home[data-nv-page] :is(section, header, nav) > h2:not(#nv-kit) { font: var(--nv-t-title-3); letter-spacing: normal; }
  html:root body .app-shell.nevora-portal .page-frame .premium-employee-home[data-nv-page] section > h3:not(#nv-kit),
  html:root body .app-shell.nevora-portal .page-frame [data-nv-page] :is(.nto-summary > h3, .updates-empty > h2):not(#nv-kit) { font: var(--nv-t-headline); letter-spacing: normal; }
  html:root body .app-shell.nevora-portal .page-frame [data-nv-page] .employee-clock-compact :is(.employee-time-link, .employee-time-refresh:not(.nv-btn)):not(#nv-kit) { font: var(--nv-t-label); }
}
/* TC-P3-30: Home's row titles are never cut at large text, as on the Inbox (TC-07). */
html body .app-shell.nevora-portal .page-frame .premium-home-view .nv-row__title:not(#nv-kit) { -webkit-line-clamp: unset; display: block; }
/* Wave A ST (Oct 19): the Manager and Owner shell's placeholders for the shared requests, exchange and availability
 * segments match their real bands. All three are flat bands for managers (measured at 320, 390 and 844×390). */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .route-skeleton[data-route="review"][data-band] { --route-band: 192px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .route-skeleton[data-route="exchange"][data-band] { --route-band: 168px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .route-skeleton[data-route="availability"][data-band] { --route-band: 220px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .route-skeleton[data-route="review"][data-band] > .route-skeleton-band + * { margin-top: var(--nv-s-4); }
}
@media (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .route-skeleton[data-route="review"][data-band] { --route-band: 168px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .route-skeleton[data-route="exchange"][data-band] { --route-band: 172px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .route-skeleton[data-route="availability"][data-band] { --route-band: 184px; }
}
/* Phase 3 round 3, alignment */
/* AL-P3-18: the Time off form's groups ("How much time", "Choose your dates", "Note") keep the card's 20px rhythm. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-timeoff .nv-card .nto-form-fields { display: flex; flex-direction: column; gap: var(--nv-s-5); }
/* AL-P3-19: the status tag always sits at the row's top right, whether or not the dates wrap. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-timeoff-row__head { flex-wrap: nowrap; align-items: flex-start; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-timeoff-row__head > .nv-row__title { flex: 1 1 auto; min-width: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-timeoff-row__head > :not(.nv-row__title) { flex: none; }
/* AL-P3-20: Profile's cards are one width (profile.css's grid "align-items: start" shrank them in the flex column),
 * with the kit's 20px inset at every phone width, landscape included. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-profile .profile-layout { align-items: stretch; }
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-profile .employee-profile-panel { padding: var(--nv-s-5); }
}
/* AL-P3-21: the specific-week card's sections run edge to edge with their own 20px inset (no second 20px around them). */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-availability .av-week-panel:not(#nv-kit) { padding: 0; overflow: hidden; }
/* AL-P3-23: Shift requests cards start their text 20px down, and their three lines start at one edge. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-exchange .employee-shift-entry:not(#nv-kit) { padding: var(--nv-s-5); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-exchange .exchange-assignment-date > svg:not(#nv-kit) { width: 16px; height: 16px; }
/* AL-P3-24: My time cards keep the 20px inset below 375px too, like every other employee card. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-time .employee-time-panel > section:not(#nv-kit) { padding: var(--nv-s-5); }
/* AL-P3-25: the entry row ends at the card's text edge: the legacy "+" no longer takes a track, and the total
 * shares the date's first line. */
html body .app-shell.nevora-portal[data-employee-corporate="true"] .page-frame .employee-time-entry > summary::after { content: none; display: none; }
html body .app-shell.nevora-portal[data-employee-corporate="true"] .page-frame .employee-time-entry-total:not(#nv-kit) { align-self: start; }
/* AL-P3-26: heads with a meta line or tag align on the title's baseline, as kit heads do. */
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] :is(.my-agenda-heading, [data-pass="true"] > header):not(#nv-kit) { align-items: baseline; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] :is(.my-agenda-heading, [data-pass="true"] > header) > :is(span, small, p) > svg { align-self: center; }
/* AL-P3-28: the Updates empty and failed states are part of the card, not a box inside it. */
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] .updates-inbox .updates-empty:not(#nv-kit) { border: 0; border-radius: 0; background: transparent; padding: var(--nv-s-5); box-shadow: none; }
/* AL-P3-13: icon-led titles inside cards use one recipe: a 20px icon with a 12px gap (text at 68), or a 40px tile with 12 (88). */
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] :is(.employee-time-current-heading, .employee-time-section-heading) h2:not(#nv-kit) { gap: 12px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] [class*="timecards-module"][class*="__issues"]:not(#nv-kit) { gap: 12px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-schedule .my-week-title:not(#nv-kit) { gap: 12px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-schedule .my-week-title > svg:not(#nv-kit) { width: 20px; height: 20px; flex: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-schedule .my-schedule-review:not(#nv-kit) { gap: 12px; padding: var(--nv-s-5); }
/* P3-ST-22: a single request's review (requestId in the URL) keeps the review's own overlap band in its placeholder,
 * while the Time off list keeps the flat band Wave A measured. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .page-frame[data-focused-review] .route-skeleton[data-route="review"][data-band] { --route-band: 264px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .page-frame[data-focused-review] .route-skeleton[data-route="review"][data-band] > .route-skeleton-band + * { margin-top: calc(-1 * var(--nv-overlap)); }
}
/* P3-ST-20: placeholder bands grow with text size like the real bands. --route-band-grow is how much each real band
 * grows from 100% to 200% text (measured Oct 19); the root layout's script supplies --nv-text-scale. Landscape bands are
 * shorter than portrait ones, so landscape has its own measured heights. Employee Profile's band is 104px now. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="profile"] { --route-band: 104px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="home"] { --route-band-grow: 151px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="schedule"] { --route-band-grow: 108px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="hub"] { --route-band-grow: 108px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="review"] { --route-band-grow: 108px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="exchange"] { --route-band-grow: 204px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="availability"] { --route-band-grow: 132px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="mytime"] { --route-band-grow: 168px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="timecards"] { --route-band-grow: 108px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="mypay"] { --route-band-grow: 132px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="profile"] { --route-band-grow: 156px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="updates"] { --route-band-grow: 132px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="notifications"] { --route-band-grow: 132px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="home"] { --route-band-grow: 252px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="inbox"] { --route-band-grow: 84px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="schedule"] { --route-band-grow: 184px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="team"] { --route-band-grow: 144px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="timecards"] { --route-band-grow: 108px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="exports"] { --route-band-grow: 132px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="payroll"] { --route-band-grow: 204px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .page-frame.page-frame[data-focused-review] .route-skeleton[data-route="review"][data-band] { --route-band-grow: 180px; }
}
@media (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="home"].route-skeleton { --route-band: 232px; --route-band-grow: 67px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="schedule"].route-skeleton { --route-band: 168px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="hub"].route-skeleton { --route-band: 104px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="review"].route-skeleton { --route-band: 168px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="exchange"].route-skeleton { --route-band: 212px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="availability"].route-skeleton { --route-band: 168px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="mytime"].route-skeleton { --route-band: 148px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="timecards"].route-skeleton { --route-band: 148px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="mypay"].route-skeleton { --route-band: 104px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="profile"].route-skeleton { --route-band: 104px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="updates"].route-skeleton { --route-band: 104px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton[data-route="notifications"].route-skeleton { --route-band: 104px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="home"].route-skeleton { --route-band: 180px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="inbox"].route-skeleton { --route-band: 268px; --route-band-grow: 84px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="schedule"].route-skeleton { --route-band: 180px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="team"].route-skeleton { --route-band: 180px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="timecards"].route-skeleton { --route-band: 148px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="exports"].route-skeleton { --route-band: 104px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.employee-shell) .route-skeleton[data-route="payroll"].route-skeleton { --route-band: 104px; --route-band-grow: 60px; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none):not(.employee-shell) .page-frame.page-frame[data-focused-review] .route-skeleton[data-route="review"][data-band].route-skeleton { --route-band: 224px; --route-band-grow: 60px; }
}
/* P3-ST-19: with reduced motion, placeholders don't shimmer (portal-motion's reduce rule lost on specificity). */
@media (prefers-reduced-motion: reduce) {
  html body .app-shell.nevora-portal .route-skeleton *:not(#nv-kit) { animation: none; }
}
/* P3-ST-18: on phones the page's own bottom padding clears the tab bar; the content column adds nothing below its last card. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-content:not(#nv-kit) { padding-bottom: 0; }
}
/* P3-ST-16: the pass's loading, failed and paused lines take two lines' room, so the placeholder bars under them don't
 * move when one message replaces another (one line at 390, two at 320). */
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-pass="true"] p[data-recovery]:not(#nv-kit) { min-height: 2lh; }
/* IS (round 3): rows that run edge to edge inside a card draw their focus ring just inside the row, so the card's
 * rounded clip never cuts it (Planning ahead, the Requests overview, Profile settings and Sign out). */
html body .app-shell.nevora-portal.nevora-portal .page-frame :is(.premium-request-hub .nv-card, .premium-employee-schedule [aria-labelledby="my-schedule-more-title"], .premium-employee-profile :is(.profile-settings-list, .profile-signout, .profile-signout-row)) :is(a, button, summary):focus-visible:not(#nv-kit) { outline: 2px solid var(--nv-accent); outline-offset: -2px; }
/* A sending submit button keeps focus (aria-disabled) and looks like the kit's disabled button. */
html body .app-shell.nevora-portal.nevora-portal .page-frame button[type="submit"][aria-disabled="true"]:not(#nv-kit) { cursor: progress; }
