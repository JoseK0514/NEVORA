html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-badge { display: inline-flex; align-items: center; min-height: 28px; padding: 0 var(--nv-s-3); border-radius: var(--nv-r-pill); font: var(--nv-t-label); text-transform: none; letter-spacing: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-empty, .manager-corrections-empty) { display: flex; flex-direction: column; align-items: flex-start; gap: var(--nv-s-1); margin: 0; padding: var(--nv-s-2) 0 0; border: 0; background: transparent; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-empty, .manager-corrections-empty) strong { font: var(--nv-t-row); color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-empty-mark, .manager-corrections-empty > span[aria-hidden]) { display: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--nv-s-2); margin: var(--nv-s-3) 0 0; padding: var(--nv-s-3) 0 0; border-top: 1px solid var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-refresh, .manager-corrections-retry, .manager-correction-actions button) {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 0 var(--nv-s-4); border: 0; border-radius: var(--nv-r-control);
  background: var(--nv-canvas); color: var(--nv-ink); box-shadow: inset 0 0 0 1px var(--nv-border); font: var(--nv-t-label); font-weight: 600;
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .manager-correction-actions button.primary { background: var(--nv-accent); color: #FFFFFF; box-shadow: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .manager-correction-actions button:disabled { background: var(--nv-inset); color: var(--nv-muted); box-shadow: inset 0 0 0 1px var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .manager-corrections-count { min-width: 28px; padding: 2px 10px; border-radius: var(--nv-r-pill); background: var(--nv-neutral-fill); color: var(--nv-neutral-ink); font: var(--nv-t-label); text-align: center; }
/* Attendance: no boxes inside the card. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review > details.panel { margin: 0 0 var(--nv-s-3); padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review > details.panel > summary { display: inline-flex; align-items: center; min-height: 44px; padding: 0; font: var(--nv-t-label); color: var(--nv-accent); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review > details.panel :is(p, li) { font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-header { order: -1; border-radius: 0; background: transparent; box-shadow: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review { display: flex; flex-direction: column; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-summary > span { display: inline-flex; align-items: baseline; gap: 6px; min-height: 0; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer { border-left: 0; border-right: 0; border-bottom: 0; border-radius: 0; background: transparent; box-shadow: none; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review { gap: var(--nv-s-2); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review > * { margin: 0; min-height: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-header { display: block; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-header .attendance-review-summary { margin: var(--nv-s-3) 0 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view .attendance-review-footer { margin-top: var(--nv-s-2); }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-home-view :is(.attendance-review-empty, .manager-corrections-empty) { text-align: left; }
