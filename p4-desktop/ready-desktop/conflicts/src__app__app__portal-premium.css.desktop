html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-schedule .my-review-jump { display: flex; align-items: center; min-height: 52px; padding: 0 var(--nv-s-5); border: 0; border-radius: var(--nv-r-control); background: var(--nv-review-fill); color: var(--nv-review-ink); font: var(--nv-t-label); font-weight: 600; }

/* ===== Phase 3, Phase 7 round 1 (alignment): every employee surface follows the kit. ===== */
/* AL-P3-01: one card style on every employee page: radius 20, kit shadow, no border. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is(.employee-view-surface:not(.employee-exchange-feed):not(.employee-calendar), .employee-time-overview, .premium-employee-timecards [class*="timecards-module"][class*="__card"], .profile-settings-list, .profile-signout, [class*="notification-inbox-module"][class*="__inbox"]:not([class*="__inboxTitle"]), .updates-inbox, .employee-view-empty, .my-schedule-feedback, .schedule-publication-change) {
  border: 0; border-radius: var(--nv-r-card); background: var(--nv-canvas); box-shadow: var(--nv-e1);
}
