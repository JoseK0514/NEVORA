html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .employee-time-correction-trigger { min-height: 52px; border: 0; border-radius: var(--nv-r-control); background: var(--nv-canvas); color: var(--nv-ink); box-shadow: inset 0 0 0 1px var(--nv-border); font: var(--nv-t-headline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-schedule .my-schedule-review { padding: var(--nv-s-5); }
/* Band titles keep the kit size on every page (the corporate employee sheet shrank h1 on My time and Timecards). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [data-nv-band] h1.nv-masthead__title { font: var(--nv-t-title-1); letter-spacing: -.022em; color: #FFFFFF; }

/* ===== Phase 3, Phase 7 round 1 (type): employee text on the kit's type roles, 15px floor on phones. ===== */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is(
