/* AL-P3-05: Notifications' head lines up with its title line (icon beside the title, Refresh centred on it). */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__inboxTitle"] { align-items: flex-start; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__inboxTitle"] > svg { margin-top: 2px; }
