html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-availability .av-button.primary { background: var(--nv-accent); color: #FFFFFF; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-availability .av-button.secondary { background: var(--nv-canvas); color: var(--nv-ink); box-shadow: inset 0 0 0 1px var(--nv-border); }
