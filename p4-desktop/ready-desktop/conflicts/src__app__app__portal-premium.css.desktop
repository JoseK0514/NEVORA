html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-legacy-page [class$="__rowTotals"] :is(dt, dd):not(#nv-kit), html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [class*="timecards-module"][class$="__rowIdentity"] small { white-space: normal; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [class*="payroll-export-module"][class$="__selectionBar"] { flex-wrap: wrap; }
