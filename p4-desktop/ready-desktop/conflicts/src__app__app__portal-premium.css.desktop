  .nto-optional, .nto-note-hint, .nto-note-hint > span,
  .exchange-assignment-detail, .exchange-assignment-lead, .exchange-assignment-zone,
  .av-day-count, .av-day-name > span, .av-deadline :is(p, span), .av-submission-detail :is(p, small),
  .employee-calendar-state,
  .updates-filter-count, .update-kind > span, .updates-status, .updates-row-copy > time,
  [class*="notification-inbox-module"][class*="__count"],
  .employee-time-section-heading > time, .my-time-history-count
) { font: var(--nv-t-callout); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .av-day-name > strong { font: var(--nv-t-row); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .employee-time-metrics dd { font: var(--nv-t-figure); letter-spacing: -.02em; }
/* The employee More sheet uses the Manager sheet's type: Inter, sentence case. */
html body .app-shell.nevora-portal.nevora-portal .employee-more-label { margin: var(--nv-s-1) var(--nv-s-3) var(--nv-s-2); font: var(--nv-t-callout); font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .employee-more-link { font: var(--nv-t-row); }
html body .app-shell.nevora-portal.nevora-portal .employee-more-profile strong { font: var(--nv-t-row); }
html body .app-shell.nevora-portal.nevora-portal .employee-more-profile small, html body .app-shell.nevora-portal.nevora-portal .employee-more-profile button { font: var(--nv-t-label); }
/* IS-66: My schedule's week strip keeps 44px day targets; on narrow phones it scrolls sideways like the manager strip. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-schedule .my-week-days { display: flex; flex-wrap: nowrap; gap: 0; overflow-x: auto; scrollbar-width: none; padding: 6px 20px; margin: -6px -20px; scroll-padding-inline: 20px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-schedule .my-week-day { flex: 1 0 2.75rem; min-width: 2.75rem; max-width: none; } /* P3-WR-06: in rem, so days widen with large text like the Manager's strip */
/* IS-69: the inline Profile link gets a 44px target without moving the sentence. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame .premium-employee-profile .profile-supporting-copy a { display: inline-block; padding-block: 12px; margin-block: -12px; }
/* IS-72: the Hours section tab is at least 44px wide in landscape. */
html body .app-shell.nevora-portal.nevora-portal .page-frame > .section-tabs .section-tab { min-width: 44px; }

/* P3-ST-03: employee placeholder bands match each employee page's real band at each width (measured Oct 19).
   Schedule and Time off are flat bands for employees (overlap bands for Manager and Owner). */
html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="home"] { --route-band: 272px; }
html body .app-shell.nevora-portal.employee-shell .route-skeleton:is([data-route="schedule"], [data-route="review"]) { --route-band: 168px; }
html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="hub"] { --route-band: 104px; }
html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="exchange"] { --route-band: 236px; }
html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="availability"] { --route-band: 192px; }
html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="mytime"] { --route-band: 172px; }
html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="timecards"] { --route-band: 148px; }
html body .app-shell.nevora-portal.employee-shell .route-skeleton:is([data-route="mypay"], [data-route="profile"], [data-route="updates"], [data-route="notifications"]) { --route-band: 128px; }
@media (max-width: 359px) {
  html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="hub"] { --route-band: 128px; }
  html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="availability"] { --route-band: 216px; }
  html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="mypay"] { --route-band: 152px; }
}
@media (max-width: 389px) {
  html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="review"] { --route-band: 192px; }
  html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="timecards"] { --route-band: 172px; }
}
@media (min-width: 361px) and (max-width: 429px) { html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="profile"] { --route-band: 104px; } }
@media (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="home"] { --route-band: 236px; }
  html body .app-shell.nevora-portal.employee-shell .route-skeleton:is([data-route="schedule"], [data-route="review"], [data-route="availability"]) { --route-band: 172px; }
  html body .app-shell.nevora-portal.employee-shell .route-skeleton:is([data-route="hub"], [data-route="mypay"], [data-route="profile"], [data-route="updates"], [data-route="notifications"]) { --route-band: 108px; }
  html body .app-shell.nevora-portal.employee-shell .route-skeleton[data-route="exchange"] { --route-band: 216px; }
  html body .app-shell.nevora-portal.employee-shell .route-skeleton:is([data-route="mytime"], [data-route="timecards"]) { --route-band: 152px; }
}
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal.employee-shell .route-skeleton:is([data-route="schedule"], [data-route="review"])[data-band] > .route-skeleton-band + * { margin-top: var(--nv-s-4); }
}
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home .premium-band-note { display: inline-flex; align-items: center; min-height: 44px; color: var(--nv-masthead-ink); font: var(--nv-t-label); }
/* The pass placeholder keeps the real lines' heights; only the status sentence shows, the rest are faint bars. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home .premium-pass-placeholder > :not(:first-child) { color: transparent; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home .premium-pass-placeholder > :is(p:nth-child(2), p:nth-child(4)) { background: linear-gradient(rgba(255, 255, 255, .12), rgba(255, 255, 255, .12)) left center / 60% 60% no-repeat; border-radius: 6px; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-home .premium-pass-placeholder > p:nth-child(3) { visibility: hidden; }
/* P3-ST-05/07: guidance notes sit above the card that grows when its read arrives, so they never move. */
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-updates .premium-employee-content > .updates-compose { order: -2; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-updates .premium-employee-content > .updates-footnote { order: -1; margin: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-pay .premium-legacy-content > .pw-privacy { order: -1; margin: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame .premium-employee-pay .premium-legacy-content { display: flex; flex-direction: column; }

/* P3-ST-08: the employee More sheet behaves like the Manager's: full width to the bottom edge, the page dimmed
   and held still behind it, its own list scrolling, Close after the list. */
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal #employee-more-navigation:popover-open { overflow-y: auto; overscroll-behavior: contain; }
  html body .app-shell.nevora-portal.nevora-portal #employee-more-navigation:popover-open::backdrop { background: rgba(28, 28, 28, .28); }
  html:has(:is(#manager-more-navigation, #employee-more-navigation):popover-open) body { overflow: hidden; }
}

/* ===== Phase 3, Phase 7 (widths P3-WR-02): Notifications rows on the kit's row type in every role. ===== */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__inboxTitle"] h2 { font: var(--nv-t-headline); letter-spacing: 0; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__inboxTitle"] p { max-width: none; font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] button[class*="notification-inbox-module"][class*="__refresh"],
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] a[class*="notification-inbox-module"][class*="__refresh"] { min-height: 44px; padding: 0 var(--nv-s-4); border: 0; border-radius: var(--nv-r-control); background: var(--nv-canvas); color: var(--nv-ink); box-shadow: inset 0 0 0 1px var(--nv-border); font: var(--nv-t-label); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] button[class*="notification-inbox-module"][class*="__refresh"]:disabled { opacity: 1; background: var(--nv-inset); color: var(--nv-muted); box-shadow: inset 0 0 0 1px var(--nv-hairline); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__filters"] > button { font: var(--nv-t-label); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is([class*="notification-inbox-module"][class*="__viewCount"], [class*="notification-inbox-module"][class*="__groupHeading"], [class*="notification-inbox-module"][class*="__footer"] p, [class*="notification-inbox-module"][class*="__notice"] p, [class*="notification-inbox-module"][class*="__empty"] p) { font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__groupHeading"] { font-weight: 600; }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__empty"] h3 { font: var(--nv-t-title-3); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__footer"] a { font: var(--nv-t-label); color: var(--nv-accent); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__rowHeading"] strong { font: var(--nv-t-row); letter-spacing: 0; color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__rowHeading"] time,
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is([class*="notification-inbox-module"][class*="__statuses"], [class*="notification-inbox-module"][class*="__destination"]) { font: var(--nv-t-callout); color: var(--nv-muted); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__statuses"] { gap: var(--nv-s-2) var(--nv-s-3); margin-top: var(--nv-s-2); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__action"]:is([data-state="required"], [data-state="available"]) { display: inline-flex; align-items: center; min-height: 28px; padding: 0 var(--nv-s-3); border-radius: var(--nv-r-pill); font: var(--nv-t-label); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__action"][data-state="required"] { background: var(--nv-review-fill); color: var(--nv-review-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__action"][data-state="available"] { background: var(--nv-neutral-fill); color: var(--nv-neutral-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__open"] { font: var(--nv-t-label); color: var(--nv-accent); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__icon"] { width: 40px; height: 40px; border-radius: 20px; }
@media (max-width: 600px) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] a[class*="notification-inbox-module"][class*="__row"] { grid-template-columns: 40px minmax(0, 1fr); gap: var(--nv-s-3); }
}
/* The filter rows fade at the edge they continue past, like the band pills (the hidden marker sets data-overflow and data-start). */
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] :is(.updates-filters, [class*="notification-inbox-module"][class*="__filters"])[data-overflow="true"] { padding-right: 28px; scroll-padding-inline: 8px 28px; -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent); }
html body .app-shell.nevora-portal.nevora-portal .page-frame [data-nv-page] :is(.updates-filters, [class*="notification-inbox-module"][class*="__filters"])[data-overflow="true"][data-start="true"] { -webkit-mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 28px), transparent); }
@media (max-width: 600px) {
  /* The band already says what Notifications is for; the inbox head keeps its title and Refresh on one line. */
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__inboxTitle"] p { display: none; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__inboxTitle"] > svg { margin-top: 0; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__inboxTitle"] { align-items: center; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__toolbar"] { align-items: center; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__refresh"] { align-self: center; margin-top: 0; padding: 0 var(--nv-s-3); gap: 6px; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__toolbar"] { gap: var(--nv-s-3); }
  /* P3-WR-10: with large text the title keeps its words and Refresh moves under it instead of colliding. */
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__toolbar"] { flex-wrap: wrap; row-gap: var(--nv-s-2); }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [class*="notification-inbox-module"][class*="__refresh"] { margin-left: auto; }
}
/* TC-P3-15: the pass's shift time keeps its display size; the phone shell's caption rule for <p> must not reach it. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [data-pass] p[class*="employee-home-reviewed-module"][class*="__interval"] { font-size: 2rem; line-height: 1.25; font-weight: 600; letter-spacing: -.04em; }
@container employee-home-reviewed (min-width: 52rem) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] [data-pass] p[class*="employee-home-reviewed-module"][class*="__interval"] { font-size: 2.25rem; }
}
/* TC-P3-17: the Time off empty state on the kit roles. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .nto-empty-state > strong { font: var(--nv-t-headline); letter-spacing: 0; color: var(--nv-ink); }
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .nto-empty-state > span:not(.nto-empty-icon) { font: var(--nv-t-callout); color: var(--nv-muted); }
/* P3-WR-03: on narrow phones each tab is its label's width plus an equal share of the spare room, so long labels never run together. */
@media (max-width: 400px) {
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav { display: flex; }
  html body .app-shell.nevora-portal.nevora-portal:not(.nv-shell-none) .mobile-nav .mobile-nav-link.mobile-nav-link { flex: 1 1 auto; width: auto; min-width: 48px; padding-inline: 0; }
}
/* P3-WR-04: an Availability day keeps its name and switch on one line while they fit; with large text the switch moves under the name instead of over it. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is(.av-availability-toggle, .av-availability-toggle > span:not(.av-switch)) { font: var(--nv-t-label); white-space: nowrap; }
@media (max-width: 760px), (max-width: 900px) and (max-height: 430px) and (orientation: landscape) and (pointer: coarse) {
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .av-day-row { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--nv-s-3); row-gap: var(--nv-s-2); }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .av-day-row > .av-day-name { flex: 1 1 auto; min-width: 0; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .av-day-row > .av-availability-toggle { flex: none; margin-left: auto; }
  html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .av-day-row > .av-time-range { flex: 1 0 100%; }
}

/* ===== P3-WR-05: employee and lead buttons below the band are kit buttons (52px, radius 12, one primary colour).
 * :not(#nv-kit) carries the ID weight that outranks the older phone button rules in portal-gusto.css. ===== */
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame [data-nv-page] :is(.employee-action, .av-button, .nto-button, .button.primary, .button.secondary, .button.calendar-primary, .employee-corporate-button--primary, .employee-corporate-button--secondary, .employee-time-correction-trigger, .pw-button):not(#nv-kit) {
  display: inline-flex; align-items: center; justify-content: center; gap: var(--nv-s-2); min-height: 52px; padding: 0 var(--nv-s-5);
  border: 0; border-radius: var(--nv-r-control); background: var(--nv-canvas); color: var(--nv-ink); box-shadow: inset 0 0 0 1px var(--nv-border);
  font: var(--nv-t-headline); letter-spacing: 0; text-decoration: none; opacity: 1;
}
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame [data-nv-page] :is(.employee-action.primary, .av-button.primary, .nto-button.nto-primary, .button.primary, .button.calendar-primary, .employee-corporate-button--primary, .pw-button:not(.pw-secondary)):not(#nv-kit) { background: var(--nv-accent); color: #FFFFFF; box-shadow: none; }
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame [data-nv-page] .employee-action.danger:not(#nv-kit) { color: var(--nv-urgent-ink); }
@media (hover: hover) {
  html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame [data-nv-page] :is(.employee-action, .av-button, .nto-button, .button.secondary, .employee-corporate-button--secondary, .employee-time-correction-trigger, .pw-button.pw-secondary):not(.primary):not(.nto-primary):not(:disabled):not([aria-disabled="true"]):not(#nv-kit):hover { background: #F7F9F8; }
  html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame [data-nv-page] :is(.employee-action.primary, .av-button.primary, .nto-button.nto-primary, .button.primary, .button.calendar-primary, .employee-corporate-button--primary):not(:disabled):not([aria-disabled="true"]):not(#nv-kit):hover { background: var(--nv-accent-hover); color: #FFFFFF; }
}
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame [data-nv-page] :is(.employee-action, .av-button, .nto-button, .button.primary, .button.secondary, .button.calendar-primary, .employee-corporate-button--primary, .employee-corporate-button--secondary, .employee-time-correction-trigger, .pw-button):is(:disabled, [aria-disabled="true"]):not(#nv-kit) { background: var(--nv-inset); color: var(--nv-muted); box-shadow: inset 0 0 0 1px var(--nv-hairline); cursor: not-allowed; }
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame [data-nv-page] :is(.employee-action, .av-button, .nto-button, .button.primary, .button.secondary, .button.calendar-primary, .employee-corporate-button--primary, .employee-corporate-button--secondary, .employee-time-correction-trigger, .pw-button):focus-visible:not(#nv-kit) { outline: 2px solid var(--nv-accent); outline-offset: 2px; }
html body .app-shell.employee-shell.nevora-portal .page-frame.page-frame [data-nv-page] .my-shift-options > summary:not(#nv-kit) { border-radius: var(--nv-r-control); }
/* P3-WR-05: Availability's day count is a kit neutral status. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] .av-day-count:not(#nv-kit) { display: inline-flex; align-items: center; min-height: 28px; padding: 0 var(--nv-s-3); border-radius: var(--nv-r-pill); background: var(--nv-neutral-fill); color: var(--nv-neutral-ink); font: var(--nv-t-label); white-space: nowrap; }
/* P3-WR-05: a Refresh inside a card head is the same quiet control everywhere (Notifications, My time): accent label, 44px, radius 12, no border. */
html body .app-shell.nevora-portal.nevora-portal .page-frame.page-frame [data-nv-page] :is(button[class*="notification-inbox-module"][class*="__refresh"], a[class*="notification-inbox-module"][class*="__refresh"], .employee-corporate-button--quiet, .employee-time-refresh:not(.employee-corporate-button--primary), .updates-refresh):not(#nv-kit) { min-height: 44px; padding: 0 var(--nv-s-3); gap: 6px; border: 0; border-radius: var(--nv-r-control); background: transparent; color: var(--nv-accent); box-shadow: none; font: var(--nv-t-label); }
