+/** One activation for the currently rendered read state. A new pending or settled
+ * render gets a new handler; synchronous controller publishing owns that cycle.
+ * Keep the mutable event state outside the pure React view functions. */
+export function createRefreshHandler(blocked:boolean,refresh:()=>void):()=>void {
+ let started=false;
+ return ()=>{
+  if(blocked||started)return;
+  started=true;
+  refresh();
+ };
+}
