CREATE POLICY portal_verifier_portal_session_issuance_insert ON nevora_tenancy.portal_session_issuance
AS PERMISSIVE FOR INSERT TO "__BOUND_AUTH_OWNER__"
WITH CHECK (
  EXISTS (
    SELECT 1
    FROM nevora_tenancy.portal_verifier_service_binding AS bound
    JOIN pg_catalog.pg_roles AS verifier
      ON verifier.oid OPERATOR(pg_catalog.=) bound.verifier_role_oid
        AND verifier.rolname OPERATOR(pg_catalog.=) bound.verifier_role_name
    JOIN pg_catalog.pg_roles AS owner_role
      ON owner_role.oid OPERATOR(pg_catalog.=) bound.writer_owner_oid
        AND owner_role.rolname OPERATOR(pg_catalog.=) bound.writer_owner_name
    JOIN pg_catalog.pg_stat_activity AS original_backend
      ON original_backend.pid OPERATOR(pg_catalog.=) pg_catalog.pg_backend_pid()
    WHERE bound.singleton
      AND bound.verifier_role_oid OPERATOR(pg_catalog.=) __BOUND_VERIFIER_LOGIN_OID__::pg_catalog.oid
      AND bound.writer_owner_oid OPERATOR(pg_catalog.=) __BOUND_AUTH_OWNER_OID__::pg_catalog.oid
      AND original_backend.datid OPERATOR(pg_catalog.=) __BOUND_DATABASE_OID__::pg_catalog.oid
      AND original_backend.usesysid OPERATOR(pg_catalog.=) verifier.oid
      AND session_user::pg_catalog.name OPERATOR(pg_catalog.=) verifier.rolname
      AND current_user::pg_catalog.name OPERATOR(pg_catalog.=) owner_role.rolname
      AND pg_catalog.current_setting('role') OPERATOR(pg_catalog.=) 'none'::pg_catalog.text
      AND pg_catalog.current_setting('transaction_isolation') OPERATOR(pg_catalog.=) 'read committed'::pg_catalog.text
      AND verifier.rolcanlogin AND NOT owner_role.rolcanlogin
      AND NOT verifier.rolsuper AND NOT verifier.rolbypassrls AND NOT verifier.rolcreatedb
      AND NOT verifier.rolcreaterole AND NOT verifier.rolreplication AND NOT verifier.rolinherit
      AND NOT owner_role.rolsuper AND NOT owner_role.rolbypassrls AND NOT owner_role.rolcreatedb
      AND NOT owner_role.rolcreaterole AND NOT owner_role.rolreplication AND NOT owner_role.rolinherit
      AND NOT EXISTS (
        SELECT 1 FROM pg_catalog.pg_auth_members AS edge
        WHERE edge.roleid IN (verifier.oid, owner_role.oid)
          OR edge.member IN (verifier.oid, owner_role.oid)
          OR edge.grantor IN (verifier.oid, owner_role.oid)
      )
      AND NOT EXISTS (
        SELECT 1 FROM nevora_tenancy.runtime_role_binding AS runtime
        WHERE runtime.role_oid IN (verifier.oid, owner_role.oid)
          OR runtime.role_name IN (verifier.rolname, owner_role.rolname)
      )
  ) AND
  pg_catalog.char_length(portal_session_issuance.token_hash::pg_catalog.text) OPERATOR(pg_catalog.=) 64::pg_catalog.int4 AND
  portal_session_issuance.token_hash::pg_catalog.text COLLATE pg_catalog."C"
    OPERATOR(pg_catalog.~) '^[a-f0-9]{64}$'::pg_catalog.text COLLATE pg_catalog."C" AND
  EXISTS (
    SELECT 1 FROM public.employee_sessions AS source_session
    JOIN public.employees AS source_employee
      ON source_employee.id OPERATOR(pg_catalog.=) source_session.employee_id
        AND pg_catalog.convert_to(source_employee.id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(source_session.employee_id,'UTF8')
    JOIN public.workspaces AS source_workspace
      ON source_workspace.id OPERATOR(pg_catalog.=) source_employee.workspace_id
        AND pg_catalog.convert_to(source_workspace.id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(source_employee.workspace_id,'UTF8')
    JOIN nevora_tenancy.workspace_incarnation_counter AS current_counter
      ON current_counter.workspace_id OPERATOR(pg_catalog.=) source_workspace.id
        AND pg_catalog.convert_to(current_counter.workspace_id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(source_workspace.id,'UTF8')
    JOIN nevora_tenancy.portal_authority AS current_portal
      ON current_portal.workspace_id OPERATOR(pg_catalog.=) source_workspace.id
        AND pg_catalog.convert_to(current_portal.workspace_id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(source_workspace.id,'UTF8')
        AND current_portal.employee_id OPERATOR(pg_catalog.=) source_employee.id
        AND pg_catalog.convert_to(current_portal.employee_id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(source_employee.id,'UTF8')
    WHERE source_session.token_hash OPERATOR(pg_catalog.=) portal_session_issuance.token_hash
      AND source_employee.id OPERATOR(pg_catalog.=) portal_session_issuance.employee_id
        AND pg_catalog.convert_to(source_employee.id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(portal_session_issuance.employee_id,'UTF8')
      AND source_workspace.id OPERATOR(pg_catalog.=) portal_session_issuance.workspace_id
        AND pg_catalog.convert_to(source_workspace.id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(portal_session_issuance.workspace_id,'UTF8')
      AND source_session.created_at IS NOT DISTINCT FROM portal_session_issuance.session_created_at
      AND source_session.expires_at OPERATOR(pg_catalog.>) pg_catalog.clock_timestamp()
      AND source_workspace.active AND source_employee.active
      AND current_counter.incarnation OPERATOR(pg_catalog.>) 0::pg_catalog.int8
      AND current_counter.incarnation OPERATOR(pg_catalog.=) portal_session_issuance.workspace_incarnation
      AND current_portal.portal_access_version OPERATOR(pg_catalog.>) 0::pg_catalog.int8
      AND current_portal.portal_access_version OPERATOR(pg_catalog.=) portal_session_issuance.portal_access_version
      AND current_portal.portal_state COLLATE pg_catalog."C" OPERATOR(pg_catalog.=) 'ENABLED'::pg_catalog.text COLLATE pg_catalog."C"
      AND current_portal.proof_provenance IN ('LEGACY_UNVERIFIED','VERIFIED')
  )
);
