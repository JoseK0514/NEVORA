-- UNUSED SOURCE FRAGMENT. NOT A STANDALONE INSTALLER OR AUTHENTICATION.
-- No SQL/QA executed. No default/public/runtime grants or seeds/activation.
-- Root exclusively binds two quoted native identifiers and three canonical OID
-- literals from independently authenticated current installer/role/database
-- observations. Reject every unresolved marker BEFORE SQL; no request renderer.
-- Use own BEGIN READ COMMITTED, existing exact exclusive catalog fence FIRST,
-- full fixed edb1 source/physical/native prerequisites, fresh private-intent
-- compilation and owner/function/ACL closure, then final acknowledged COMMIT.
-- Existing storage sources/guards/FORCE RLS are preserved; append policies only.
-- G is original verifier/backend + bound safe owner continuity, not password
-- verification or tenant/session isolation. Every fixed root must bind the
-- presented locator/number explicitly. Private rows without a bearer cannot
-- prove password success. Same-client actual Node scrypt remains mandatory.
-- This does not call the APP reader/original-runtime-login helper or admit a
-- new audited graph node. The verifier lane is separately enrolled and closed.
-- Lock-only UPDATE has WITH CHECK(false); matching updates cannot survive.
-- Empty/zero-target UPDATE may affect zero rows rather than raise; test both.
-- Dependency graph: mapping/locator/counter/Portal -> public W/E + non-RLS
-- technical binding; LIVE -> public session/W/E + counter/Portal -> public W/E.
-- No counter/Portal predicate refers to LIVE/session; no recursive RLS helper.
-- The technical binding table remains installer-owned/noncustomer; this
-- fragment cannot populate it, transfer ownership or authenticate its capsule.

CREATE POLICY portal_verifier_employee_login_identity_select ON nevora_tenancy.employee_login_identity
AS PERMISSIVE FOR SELECT TO "__BOUND_AUTH_OWNER__"
USING (
  EXISTS (
    SELECT 1
    FROM nevora_tenancy.portal_verifier_service_binding AS bound
    JOIN pg_catalog.pg_roles AS verifier
      ON verifier.oid OPERATOR(pg_catalog.=) bound.verifier_role_oid
        AND verifier.rolname OPERATOR(pg_catalog.=) bound.verifier_role_name
    JOIN pg_catalog.pg_roles AS owner_role
      ON owner_role.oid OPERATOR(pg_catalog.=) bound.writer_owner_oid
        AND owner_role.rolname OPERATOR(pg_catalog.=) bound.writer_owner_name
    JOIN pg_catalog.pg_stat_activity AS original_backend
      ON original_backend.pid OPERATOR(pg_catalog.=) pg_catalog.pg_backend_pid()
    WHERE bound.singleton
      AND bound.verifier_role_oid OPERATOR(pg_catalog.=) __BOUND_VERIFIER_LOGIN_OID__::pg_catalog.oid
      AND bound.writer_owner_oid OPERATOR(pg_catalog.=) __BOUND_AUTH_OWNER_OID__::pg_catalog.oid
      AND original_backend.datid OPERATOR(pg_catalog.=) __BOUND_DATABASE_OID__::pg_catalog.oid
      AND original_backend.usesysid OPERATOR(pg_catalog.=) verifier.oid
      AND session_user::pg_catalog.name OPERATOR(pg_catalog.=) verifier.rolname
      AND current_user::pg_catalog.name OPERATOR(pg_catalog.=) owner_role.rolname
      AND pg_catalog.current_setting('role') OPERATOR(pg_catalog.=) 'none'::pg_catalog.text
      AND pg_catalog.current_setting('transaction_isolation') OPERATOR(pg_catalog.=) 'read committed'::pg_catalog.text
      AND verifier.rolcanlogin AND NOT owner_role.rolcanlogin
      AND NOT verifier.rolsuper AND NOT verifier.rolbypassrls AND NOT verifier.rolcreatedb
      AND NOT verifier.rolcreaterole AND NOT verifier.rolreplication AND NOT verifier.rolinherit
      AND NOT owner_role.rolsuper AND NOT owner_role.rolbypassrls AND NOT owner_role.rolcreatedb
      AND NOT owner_role.rolcreaterole AND NOT owner_role.rolreplication AND NOT owner_role.rolinherit
      AND NOT EXISTS (
        SELECT 1 FROM pg_catalog.pg_auth_members AS edge
        WHERE edge.roleid IN (verifier.oid, owner_role.oid)
          OR edge.member IN (verifier.oid, owner_role.oid)
          OR edge.grantor IN (verifier.oid, owner_role.oid)
      )
      AND NOT EXISTS (
        SELECT 1 FROM nevora_tenancy.runtime_role_binding AS runtime
        WHERE runtime.role_oid IN (verifier.oid, owner_role.oid)
          OR runtime.role_name IN (verifier.rolname, owner_role.rolname)
      )
  ) AND
  EXISTS (
    SELECT 1 FROM public.employees AS source_employee
    JOIN public.workspaces AS source_workspace
      ON source_workspace.id OPERATOR(pg_catalog.=) source_employee.workspace_id
        AND pg_catalog.convert_to(source_workspace.id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(source_employee.workspace_id,'UTF8')
    WHERE source_employee.id OPERATOR(pg_catalog.=) employee_login_identity.employee_id
        AND pg_catalog.convert_to(source_employee.id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(employee_login_identity.employee_id,'UTF8')
      AND source_workspace.id OPERATOR(pg_catalog.=) employee_login_identity.workspace_id
        AND pg_catalog.convert_to(source_workspace.id,'UTF8') OPERATOR(pg_catalog.=) pg_catalog.convert_to(employee_login_identity.workspace_id,'UTF8')
      AND source_workspace.active AND source_employee.active
  )
);

