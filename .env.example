DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# One company per database. Setup is an explicit operator command.
# Set a separate target; setup never falls back to the application's DATABASE_URL.
NEVORA_SETUP_ENVIRONMENT="development"
NEVORA_SETUP_DATABASE_URL=""
NEVORA_SETUP_DATABASE_NAME=""
COMPANY_NAME=""
COMPANY_TIME_ZONE=""
COMPANY_LOCATION_NAME=""
COMPANY_LOCATION_SHORT_NAME=""
COMPANY_LOCATION_KEY=""

# Private owner configuration for setup:company or bootstrap:owner.
BOOTSTRAP_EMPLOYEE_ID=""
BOOTSTRAP_FIRST_NAME=""
BOOTSTRAP_LAST_NAME=""
BOOTSTRAP_PHONE=""
BOOTSTRAP_EMAIL=""
BOOTSTRAP_PASSWORD=""
# Additional owners in an existing configured company require explicit locations.
BOOTSTRAP_PRIMARY_LOCATION_ID=""
BOOTSTRAP_ELIGIBLE_LOCATION_IDS=""

# Phase 3 portal notifications: disabled until separate activation is authorized.
# Test/production require separate databases, protection keys, VAPID pairs and worker secrets.
# Canonical HTTPS origin; disabled local testing may use loopback HTTP.
FUEL_PORTAL_ORIGIN=""
PUSH_FEATURE_ENABLED="false"
PUSH_DELIVERY_ENABLED="false"
PUSH_ENVIRONMENT="test"
PUSH_VAPID_PUBLIC_KEY=""
PUSH_VAPID_PRIVATE_KEY=""
PUSH_VAPID_SUBJECT=""
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=""
NOTIFICATION_WORKER_SECRET=""
# Only deliberately opted-in test accounts/devices may queue current-device tests.
PUSH_TEST_DELIVERY_ENABLED="false"
PUSH_TEST_ACCOUNT_IDS=""

# Phase C: use a separate, explicitly approved Clocker environment and database.
# Production requires its canonical HTTPS origin; no forwarded-host fallback.
NEVORA_CLOCKER_ORIGIN=""
# A persistent, secret 32-byte key encoded as 64 hexadecimal characters.
# Never NEXT_PUBLIC, never commit a value, and never reuse a production key in QA.
# Key identity is pinned at first PIN setup. Rotation needs a reviewed reset/migration.
NEVORA_CLOCKER_PIN_KEY=""

# Phase C punch API: keep disabled until schema, UX and release gates are approved.
NEVORA_CLOCKER_PUNCH_ENABLED="false"

# Optional registered-email recovery through an existing approved SMTP account.
# FUEL_PORTAL_ORIGIN must be the canonical HTTPS portal origin in production.
# Blank configuration leaves the customer-facing assisted recovery path available.
# Production SMTP uses TLS (465) or mandatory STARTTLS; never NEXT_PUBLIC.
NEVORA_RECOVERY_SMTP_HOST=""
NEVORA_RECOVERY_SMTP_PORT="465"
NEVORA_RECOVERY_SMTP_USER=""
NEVORA_RECOVERY_SMTP_PASSWORD=""
NEVORA_RECOVERY_FROM=""
