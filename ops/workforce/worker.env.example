# CURATED WORKER CONFIGURATION ONLY. Never copy a complete web/provisioner environment.
# No real credential or approved runtime activation is supplied here.
NEVORA_OPERATIONS_ENABLED=false
NEVORA_OPERATIONS_ENVIRONMENT=test
NEVORA_OPERATIONS_SOURCE_SHA=REPLACE_WITH_REVIEWED_40_HEX_COMMIT
NEVORA_OPERATIONS_SCOPE_ID=REPLACE_WITH_EXACT_COMPANY_UUID
NEVORA_OPERATIONS_STATE_DIR=/var/lib/nevora-workforce/REPLACE_WITH_EXACT_COMPANY_UUID
NEVORA_OPERATIONS_DEADLINE_SECONDS=120
# Explicit proposed values: owner/operator must approve cadence and thresholds before activation.
NEVORA_OPERATIONS_MAX_HEARTBEAT_GAP_SECONDS=600
NEVORA_OPERATIONS_MAX_QUEUE_AGE_SECONDS=600
NEVORA_WORKSPACE_MODE=isolated
NEVORA_ONBOARDING_ENVIRONMENT=test
NEVORA_PORTAL_BASE_DOMAIN=portal-staging.nevora.team
NEVORA_WORKER_WORKSPACE_ORIGIN=https://REPLACE_WITH_APPROVED_COMPANY.portal-staging.nevora.team
# Secure store supplies ONLY the company/environment-bound nv_control_worker_t_<UUID_WITHOUT_HYPHENS> LOGIN URL.
# NEVORA_CONTROL_DATABASE_URL=<sensitive approved worker-reader URL, verify-full for Neon>
# NEVORA_ONBOARDING_TOKEN_ENCRYPTION_KEY=<sensitive routing decryption key>
# NEVORA_COMMERCE_API_ORIGIN=<reviewed exact commerce API origin>
# NEVORA_COMMERCE_WORKER_BINDING_KEY=<sensitive WORKER-only commerce binding key>
# Keep NEVORA_WORKSPACE_TOKEN_SECRET and NEVORA_COMMERCE_BINDING_KEY COMPLETELY ABSENT.
# Never add management/bootstrap, Stripe or SMTP credentials to this worker environment.
NEVORA_PAYROLL_ENABLED=false
PUSH_FEATURE_ENABLED=false
PUSH_DELIVERY_ENABLED=false
PUSH_TEST_DELIVERY_ENABLED=false
PUSH_ENVIRONMENT=test
PUSH_TEST_ACCOUNT_IDS=
# Preserve billing enforcement for the enrolled company; missing credentials fail closed.
NEVORA_COMMERCE_ENABLED=true
# PUSH_VAPID_PUBLIC_KEY, PUSH_VAPID_PRIVATE_KEY, PUSH_VAPID_SUBJECT,
# PUSH_SUBSCRIPTION_ENCRYPTION_KEY and NOTIFICATION_WORKER_SECRET require separate approved Web Push custody.
